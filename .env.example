# Copie para .env apenas no ambiente de execução. Nunca versione valores reais.
POSTGRES_USER=orbit_admin
POSTGRES_PASSWORD=change-me-with-a-secret-manager
POSTGRES_DB=orbit
APP_DATABASE_USER=orbit_app
APP_DATABASE_PASSWORD=change-me-with-a-secret-manager

JWT_ACCESS_SECRET=change-me-at-least-32-random-characters
# Base64 de 32 bytes; manter a mesma chave em todas as réplicas da API.
# Protege segredos MFA e a resposta temporária de rotação de sessão.
# Also encrypts pending identity emails; keep consistent across replicas and backups.
ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
# Segredos independentes; mesmos valores nas réplicas. Nunca NEXT_PUBLIC_*.
# TRUSTED_PROXY_SECRET também no frontend e no include privado do Nginx.
TRUSTED_PROXY_SECRET=change-me-64-hex-characters
AUTH_RATE_LIMIT_SECRET=change-me-64-hex-characters
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_ORIGIN_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
TRIAL_FINGERPRINT_SECRET=change-me-dedicated-long-lived-random-secret

FRONTEND_ORIGIN=https://app.example.com
IDENTITY_PUBLIC_WEB_URL=https://app.example.com
AUTH_COOKIE_SECURE=true
ALLOW_INSECURE_LOCAL_COOKIES=false
API_HOST=0.0.0.0
API_PORT=6001
FRONTEND_PORT=7070

# Links públicos do app de campo. Valores fictícios até a publicação nas lojas.
ORBIT_MOBILE_PLAY_STORE_URL=https://example.com/orbit/android
ORBIT_MOBILE_APP_STORE_URL=https://example.com/orbit/ios

# R2: public avatars/logos, private evidence/signatures/PDFs. Never expose these keys to clients.
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=orbit-assets
R2_PRIVATE_BUCKET_NAME=orbit-assets-private
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn-orbit.allblue-labs.com
STORAGE_PUBLIC_API_URL=https://orbit.allblue-labs.com/api/v1
STORAGE_SIGNED_URL_TTL_SECONDS=300
R2_LEGACY_PRIVATE_BUCKETS=orbit-artifacts,documents

# Release provenance: use the exact immutable Git SHA and RFC 3339 UTC time.
# O servidor só baixa imagens. Build local: adicione -f docker-compose.build.yml.
ORBIT_VERSION=git-sha-or-release-id
# Opcional: referências completas com tag ou digest para cada imagem.
ORBIT_API_IMAGE=
ORBIT_MIGRATOR_IMAGE=
ORBIT_FRONTEND_IMAGE=
ORBIT_COMMIT_SHA=full-git-commit-sha
ORBIT_BUILD_TIME=2026-01-01T00:00:00Z

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-at-first-login
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Administrator

# Transactional email: Amazon SES only. Never use NEXT_PUBLIC_* keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=no-reply@example.com
# Optional, only for temporary AWS credentials.
AWS_SESSION_TOKEN=

STRIPE_ENABLED=false
# When STRIPE_ENABLED=true, configure STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, all 12 STRIPE_PRICE_* mappings and the three
# BILLING_*_URL values through the deployment secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Use Price IDs (price_...), never Product IDs (prod_...).
# Account secret/restricted API keys: sk_test_/sk_live_ or rk_test_/rk_live_.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_SEMIANNUAL=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_SEMIANNUAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_INTELLIGENCE_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_INTELLIGENCE_SEMIANNUAL=
STRIPE_PRICE_PROFESSIONAL_INTELLIGENCE_ANNUAL=
STRIPE_PRICE_ENTERPRISE_UNLIMITED_MONTHLY=
STRIPE_PRICE_ENTERPRISE_UNLIMITED_SEMIANNUAL=
STRIPE_PRICE_ENTERPRISE_UNLIMITED_ANNUAL=
BILLING_CHECKOUT_SUCCESS_URL=
BILLING_CHECKOUT_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
# Durable inbox worker. Disable only in dedicated HTTP-only replicas.
BILLING_EVENTS_WORKER_ENABLED=true
BILLING_EVENTS_POLL_INTERVAL_MS=2000

# Native mobile push through Firebase Admin.
# VAPID_* applies to web push and does not configure native mobile push.
# Firebase Admin sends directly from the API/worker. Use disabled until configured.
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# Must match ORBIT_FIREBASE_PROJECT_ID in the mobile build and both public client files.
FIREBASE_CLIENT_EMAIL=
# Copy private_key from the service account JSON; preserve literal \n escapes.
FIREBASE_PRIVATE_KEY=
# Optional legacy gateway transport, unused by Firebase.
PUSH_GATEWAY_URL=
PUSH_GATEWAY_CREDENTIAL=
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=2000
