{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.allblue-labs.com/federation/1.0.0/event-page.schema.json",
  "title": "PROPOSED / PENDING_NEXUS_DECISION — event-page.schema.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0.0"
    },
    "fromCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "completeThrough": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gapDetected": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      },
      "maxItems": 100
    }
  },
  "required": [
    "protocolVersion",
    "fromCursor",
    "nextCursor",
    "completeThrough",
    "gapDetected",
    "events"
  ],
  "additionalProperties": false
}
