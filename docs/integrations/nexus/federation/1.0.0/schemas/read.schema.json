{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.allblue-labs.com/federation/1.0.0/read.schema.json",
  "title": "PROPOSED / PENDING_NEXUS_DECISION — read.schema.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0.0"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/target"
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "aggregateVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermark": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "TENANT"
            },
            "registered": {
              "const": true
            },
            "operationalStatus": {
              "enum": [
                "ACTIVE",
                "ONBOARDING",
                "SUSPENDED",
                "UNAVAILABLE"
              ]
            },
            "operationalVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "reasonCode": {
              "anyOf": [
                {
                  "enum": [
                    "SECURITY",
                    "ABUSE",
                    "ADMINISTRATIVE",
                    "RESOLVED"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "registered",
            "operationalStatus",
            "operationalVersion",
            "reasonCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SUBSCRIPTION"
            },
            "source": {
              "enum": [
                "CANONICAL",
                "UNKNOWN_LEGACY"
              ]
            },
            "subscriptionId": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "subscriptionVersion": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/positive"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "common.schema.json#/$defs/subscriptionStatus"
            },
            "planCode": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/planCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "billingInterval": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/billingInterval"
                },
                {
                  "type": "null"
                }
              ]
            },
            "catalogVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rightsVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currentPeriodEnd": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "trialEndsAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cancelAtPeriodEnd": {
              "type": "boolean"
            },
            "pendingChange": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "subscriptionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "subscriptionVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "currentPlanCode": {
                      "$ref": "common.schema.json#/$defs/planCode"
                    },
                    "targetPlanCode": {
                      "$ref": "common.schema.json#/$defs/planCode"
                    },
                    "billingInterval": {
                      "$ref": "common.schema.json#/$defs/billingInterval"
                    },
                    "effectiveAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "targetPriceVersionRef": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "subscriptionId",
                    "subscriptionVersion",
                    "currentPlanCode",
                    "targetPlanCode",
                    "billingInterval",
                    "effectiveAt",
                    "targetPriceVersionRef"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "priceVersionRef": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "source",
            "subscriptionId",
            "subscriptionVersion",
            "status",
            "planCode",
            "billingInterval",
            "catalogVersion",
            "rightsVersion",
            "currentPeriodEnd",
            "trialEndsAt",
            "cancelAtPeriodEnd",
            "pendingChange",
            "priceVersionRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "BILLING"
            },
            "invoiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "subscriptionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "billing": {
              "$ref": "common.schema.json#/$defs/billingContext"
            },
            "currency": {
              "$ref": "common.schema.json#/$defs/currency"
            },
            "amountMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "enum": [
                "DRAFT",
                "OPEN",
                "PAID",
                "VOID",
                "UNCOLLECTIBLE",
                "UNKNOWN"
              ]
            },
            "settledAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confirmedProviderPaymentMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "invoiceId",
            "subscriptionId",
            "billing",
            "currency",
            "amountMinor",
            "status",
            "settledAt",
            "confirmedProviderPaymentMinor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "USAGE"
            },
            "metric": {
              "type": "object",
              "properties": {
                "definitionRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "definitionVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "enum": [
                    "COUNT",
                    "BYTES"
                  ]
                },
                "window": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "until": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "timeZone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "from",
                    "until",
                    "timeZone"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "definitionRef",
                "definitionVersion",
                "value",
                "unit",
                "window"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "metric"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "target",
    "asOf",
    "aggregateVersion",
    "watermark",
    "freshness",
    "data"
  ],
  "additionalProperties": false
}
