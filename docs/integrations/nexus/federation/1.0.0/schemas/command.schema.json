{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.allblue-labs.com/federation/1.0.0/command.schema.json",
  "title": "PROPOSED / PENDING_NEXUS_DECISION — command.schema.json",
