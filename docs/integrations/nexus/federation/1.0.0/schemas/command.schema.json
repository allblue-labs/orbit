    "grantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "delegationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "correlationId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "reasonCode": {
      "enum": [
        "CUSTOMER_REQUEST",
        "SECURITY",
        "ABUSE",
        "ADMINISTRATIVE",
        "RESOLVED"
      ]
    },
    "precondition": {
      "$ref": "common.schema.json#/$defs/precondition"
    },
    "parameters": {
      "type": "object"
    }
  },
  "required": [
    "protocolVersion",
    "commandId",
    "type",
    "issuer",
    "connectorClientId",
    "target",
    "linkId",
    "grantId",
    "delegationRef",
    "correlationId",
    "issuedAt",
    "expiresAt",
    "reasonCode",
    "precondition",
