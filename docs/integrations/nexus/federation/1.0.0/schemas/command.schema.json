    "commandId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "connectorClientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/optionalTenantTarget"
    },
    "linkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
