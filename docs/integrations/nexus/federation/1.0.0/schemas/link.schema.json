{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.allblue-labs.com/federation/1.0.0/link.schema.json",
  "title": "PROPOSED / PENDING_NEXUS_DECISION — link.schema.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0.0"
    },
    "linkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nexusPartyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/optionalTenantTarget"
    },
    "nexusCommercialContractIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "orbitSubscriptionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "PENDING_VERIFICATION",
        "VERIFIED_PENDING_PROVISIONING",
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "verifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "auditRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "protocolVersion",
    "linkId",
    "nexusPartyId",
    "target",
    "nexusCommercialContractIds",
    "orbitSubscriptionId",
    "status",
    "version",
    "evidenceRef",
    "verifiedAt",
    "updatedAt",
    "auditRef"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    }
  ]
}
