{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.allblue-labs.com/federation/1.0.0/common.schema.json",
  "title": "PROPOSED / PENDING_NEXUS_DECISION — common.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "environment": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "productId",
        "environment",
        "instanceId",
        "tenantId"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "environment": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "required": [
        "productId",
        "environment",
        "instanceId"
      ],
      "additionalProperties": false
    },
    "optionalTenantTarget": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "environment": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "productId",
        "environment",
        "instanceId"
      ],
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "TENANT",
            "SUBSCRIPTION",
            "INVOICE",
            "PAYMENT",
            "ADJUSTMENT",
            "USAGE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "billingInterval": {
      "enum": [
        "MONTHLY",
        "SEMIANNUAL",
        "ANNUAL"
      ]
    },
    "planCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "subscriptionStatus": {
      "enum": [
        "PENDING_PAYMENT",
        "TRIALING",
        "ACTIVE",
        "PAST_DUE",
        "GRACE_PERIOD",
        "SUSPENDED",
        "CANCELED",
        "EXPIRED",
        "UNKNOWN"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "billingContext": {
      "type": "object",
      "properties": {
        "billingAccountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "mode": {
          "enum": [
            "TEST",
            "LIVE"
          ]
        }
      },
      "required": [
        "billingAccountRef",
        "mode"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "completeThrough": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        },
        "gapDetected": {
          "type": "boolean"
        }
      },
      "required": [
        "observedAt",
        "completeThrough",
        "state",
        "gapDetected"
      ],
      "additionalProperties": false
    },
    "precondition": {
      "type": "object",
      "properties": {
        "aggregate": {
          "enum": [
            "TENANT",
            "SUBSCRIPTION",
            "LINK"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "aggregate",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
