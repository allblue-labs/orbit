    "/commands": {
      "post": {
        "operationId": "submitCommand",
        "x-status": "PENDING_NEXUS_DECISION",
        "description": "202 only after durable receipt. Actual scope is selected by command allowlist, not arbitrary caller choice. Repeated equivalent submission returns original receipt; no reexecution.",
        "security": [
          {
            "federatedOAuth": [
              "allblue.tenants.provision"
            ],
            "httpMessageSignature": []
          },
          {
            "federatedOAuth": [
              "allblue.tenants.update"
            ],
            "httpMessageSignature": []
          },
          {
            "federatedOAuth": [
              "allblue.subscriptions.request"
            ],
            "httpMessageSignature": []
          },
          {
            "federatedOAuth": [
              "allblue.tenants.access.request"
            ],
            "httpMessageSignature": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{16,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/command.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original durable receipt after authorized replay; may already be terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/receipt.schema.json"
                }
              }
            }
          },
          "202": {
            "description": "Durable receipt accepted, awaiting approval/execution; not applied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/receipt.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "409": {
            "$ref": "#/components/responses/ContractError"
          },
          "410": {
            "$ref": "#/components/responses/ContractError"
          },
          "422": {
            "$ref": "#/components/responses/ContractError"
          },
          "429": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
