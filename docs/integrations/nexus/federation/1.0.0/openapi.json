  "components": {
    "securitySchemes": {
      "federatedOAuth": {
        "type": "oauth2",
        "description": "Proposed IdP; asymmetric client authentication and verified human delegation for commands are additional requirements, not implied by this schema.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://idp.example.invalid/oauth/token",
            "scopes": {
              "allblue.tenants.read": "Diretório/tenant autorizado e minimizado",
              "allblue.subscriptions.read": "Assinatura canônica autorizada",
              "allblue.billing.read": "Fatos financeiros minimizados; purpose obrigatório",
              "allblue.usage.read": "Uso agregado, futuro e desabilitado",
              "allblue.tenants.provision": "Solicitar provisionamento aprovado",
              "allblue.tenants.update": "Alterar metadados não financeiros permitidos",
              "allblue.subscriptions.request": "Solicitar alteração/cancelamento/keep com consentimento",
              "allblue.tenants.access.request": "Solicitar suspensão/reativação aprovada",
              "allblue.receipts.read": "Consultar recibos dentro do grant/cliente/target autorizado",
              "allblue.events.publish": "Publicar fatos do produto registrado",
              "allblue.events.catch_up": "Consultar eventos autorizados para reconciliação"
            }
          }
        }
      },
      "httpMessageSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Signature",
        "description": "OpenAPI presence descriptor only: RFC 9421 signature + Signature-Input + Content-Digest and signed context required; not an API key or implementation."
      }
    },
    "responses": {
