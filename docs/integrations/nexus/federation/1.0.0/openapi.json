    "title": "Allblue federated protocol — PROPOSED, no runtime endpoints",
    "version": "1.0.0",
    "description": "PENDING_NEXUS_DECISION. All servers are synthetic example.invalid. This document neither enables routes nor validates OAuth, signatures or delegation."
  },
  "x-approval-status": "PENDING_NEXUS_DECISION",
  "x-runtime-implemented": false,
  "servers": [
    {
      "url": "https://product.example.invalid/api/v1/corporate",
      "description": "Product boundary proposed; not the existing platform-admin API"
    }
