  "components": {
    "securitySchemes": {
      "TechnicalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Orbit CA1 opaque token",
        "description": "Token técnico gerado para um único ambiente."
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
        "schema": {
          "type": "string"
        }
      },
      "OrganizationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "NexusAdministratorId": {
        "name": "X-Nexus-Administrator-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Referência declarada ao administrador do Nexus. Registrada para auditoria e sem efeito sobre autenticação ou autorização.",
        "example": "e2b06693-0788-43a9-bf10-38af5b94e660"
      },
      "RequiredNexusAdministratorId": {
        "name": "X-Nexus-Administrator-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Referência declarada ao administrador do Nexus. Registrada para auditoria e sem efeito sobre autenticação ou autorização.",
        "example": "e2b06693-0788-43a9-bf10-38af5b94e660"
      }
    },
    "schemas": {
      "ConnectionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string",
                "const": "orbit-corporate-admin"
              },
              "version": {
                "type": "string",
                "const": "1.0.0"
              }
            },
            "required": [
              "service",
              "version"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "const": "connection:read"
                }
              }
            },
            "required": [
              "capabilities"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "error",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "CorporateSuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {},
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
