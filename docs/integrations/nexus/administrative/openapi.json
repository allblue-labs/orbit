    "/api/v1/corporate-admin/organizations": {
      "get": {
        "operationId": "corporateAdminListOrganizations",
        "tags": [
          "Administração corporativa"
        ],
        "summary": "Lista organizações clientes",
        "x-required-capability": "organizations:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/NexusAdministratorId"
          },
          {
            "name": "q",
            "in": "query",
            "description": "Busca parcial sem distinção de caixa por nome de exibição, empresarial ou comercial. UUID e CPF/CNPJ são pesquisados por correspondência exata, com ou sem máscara do documento.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 180
            },
            "example": "Arco Clima"
          },
          {
            "name": "operationalStatus",
            "in": "query",
            "description": "Estado operacional da organização.",
            "schema": {
              "type": "string",
              "enum": [
                "ONBOARDING",
                "ACTIVE",
                "SUSPENDED",
                "CANCELLED"
              ]
            },
            "example": "ACTIVE"
          },
          {
            "name": "planCode",
            "in": "query",
            "description": "Código persistido na assinatura canônica.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "example": "ESSENTIAL"
          },
          {
            "name": "subscriptionStatus",
            "in": "query",
            "description": "Estado persistido na assinatura canônica. UNKNOWN seleciona organizações sem assinatura canônica.",
            "schema": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "PENDING_PAYMENT",
                "TRIALING",
                "ACTIVE",
                "PAST_DUE",
                "GRACE_PERIOD",
                "SUSPENDED",
                "CANCELED",
                "EXPIRED"
              ]
            },
            "example": "TRIALING"
          },
          {
            "name": "registeredFrom",
            "in": "query",
            "description": "Limite inferior inclusivo, em UTC.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
            },
            "example": "2026-11-01T00:00:00Z"
          },
          {
            "name": "registeredBefore",
            "in": "query",
            "description": "Limite superior exclusivo, em UTC. Deve ser posterior a registeredFrom se ambos estiverem presentes.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
            },
            "example": "2026-12-01T00:00:00Z"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Página iniciada em 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Quantidade máxima de organizações por página.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "example": 25
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Ordenação com desempate pelo identificador.",
            "schema": {
              "type": "string",
              "enum": [
                "registeredAt",
                "displayName"
              ],
              "default": "registeredAt"
            },
            "example": "displayName"
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Direção da ordenação.",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "example": "asc"
          }
        ],
        "responses": {
          "200": {
            "description": "Operação corporativa concluída.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationListResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "items": [
                      {
                        "id": "0b2af05c-cb42-48d2-be07-f192f705e06f",
                        "displayName": "Arco Clima",
                        "legalName": "Arco Climatização Ltda.",
                        "tradeName": "Arco Clima",
                        "document": {
                          "type": "CNPJ",
                          "number": "12.345.678/0001-95"
                        },
                        "primarySegment": "HVAC_R",
                        "operationalStatus": "ACTIVE",
                        "operational": true,
                        "registeredAt": "2026-11-01T12:00:00.000Z",
                        "updatedAt": "2026-11-26T16:30:00.123Z",
                        "unitCount": 1,
                        "userCount": 3,
                        "subscription": {
                          "source": "CANONICAL",
                          "status": "TRIALING",
                          "planCode": "ESSENTIAL",
                          "effectiveStatus": "TRIALING",
                          "effectivePlanCode": "ESSENTIAL",
                          "accessGranted": true,
                          "billingInterval": "MONTHLY",
                          "currentPeriodStart": "2026-11-01T12:00:00.000Z",
                          "currentPeriodEnd": "2026-12-01T12:00:00.000Z",
                          "trialStartsAt": "2026-11-01T12:00:00.000Z",
                          "trialEndsAt": "2026-12-01T12:00:00.000Z"
                        }
                      }
                    ],
                    "total": 1,
                    "page": 1,
                    "pageSize": 25
                  },
                  "requestId": "c935d32a-9ad2-409c-a28c-c922dcc16f2c",
                  "timestamp": "2026-11-26T16:30:00.123Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/CorporateValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
