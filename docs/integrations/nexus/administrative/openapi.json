{
  "openapi": "3.1.0",
  "info": {
    "title": "Orbit Corporate Administration",
    "version": "1.0.0",
    "description": "Fronteira opt-in e uso exclusivamente HTTPS em ambientes implantados."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origem confiável do Orbit para esta instalação."
    }
  ],
  "security": [
    {
      "TechnicalBearer": []
    }
  ],
  "paths": {
    "/api/v1/corporate-admin/connection": {
      "get": {
        "operationId": "corporateAdminConnection",
        "summary": "Verifica a conexão técnica",
        "tags": [
          "Administração corporativa"
        ],
        "description": "Exige a capability connection:read em todas as rotas desta versão.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta autenticada.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/corporate-admin/version": {
      "get": {
        "operationId": "corporateAdminVersion",
        "summary": "Identifica a API administrativa e sua versão",
        "tags": [
          "Administração corporativa"
        ],
        "description": "Exige a capability connection:read em todas as rotas desta versão.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta autenticada.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/corporate-admin/capabilities": {
      "get": {
        "operationId": "corporateAdminCapabilities",
        "summary": "Lista as capabilities habilitadas para esta fronteira",
        "tags": [
          "Administração corporativa"
        ],
        "description": "Exige a capability connection:read em todas as rotas desta versão.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta autenticada.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TechnicalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Orbit CA1 opaque token",
        "description": "Token técnico gerado para um único ambiente."
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "description": "Identificador da requisição ou correlação reconhecida pelo Orbit.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ConnectionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string",
                "const": "orbit-corporate-admin"
              },
              "version": {
                "type": "string",
                "const": "1.0.0"
              }
            },
            "required": [
              "service",
              "version"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "const": "connection:read"
                }
              }
            },
            "required": [
              "capabilities"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "data",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "error",
          "requestId",
          "timestamp"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credencial técnica ausente ou inválida.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "HTTPS não atestado ou capability insuficiente.",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Fronteira desabilitada.",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite compartilhado das rotas corporativas excedido.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Armazenamento do limite temporariamente indisponível.",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "InternalError": {
        "description": "Erro interno.",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
