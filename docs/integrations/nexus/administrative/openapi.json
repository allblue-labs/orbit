          "billingInterval": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "MONTHLY",
              "SEMIANNUAL",
              "ANNUAL",
              null
            ]
          },
          "currentPeriodStart": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "currentPeriodEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "trialStartsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "trialEndsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "status",
          "planCode",
          "effectiveStatus",
          "effectivePlanCode",
          "accessGranted",
          "billingInterval",
          "currentPeriodStart",
          "currentPeriodEnd",
          "trialStartsAt",
          "trialEndsAt"
        ],
        "additionalProperties": false
      },
      "OrganizationRegistrationFields": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "legalName": {
            "type": [
              "string",
              "null"
            ]
          },
          "tradeName": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "number": {
                    "type": "string",
                    "maxLength": 32
                  }
                },
                "required": [
                  "type",
                  "number"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "primarySegment": {
            "type": "string"
          },
          "operationalStatus": {
            "type": "string"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
          },
          "unitCount": {
            "type": "integer",
