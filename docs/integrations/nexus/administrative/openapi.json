          "status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "PENDING_PAYMENT",
              "TRIALING",
              "ACTIVE",
              "PAST_DUE",
              "GRACE_PERIOD",
              "SUSPENDED",
              "CANCELED",
              "EXPIRED"
            ],
