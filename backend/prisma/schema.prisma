model ProductCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String    @db.VarChar(140)
  slug           String    @db.VarChar(140)
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     ProductCategory[] @relation("ProductCategoryHierarchy")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId, deletedAt])
  @@map("product_categories")
}

/// O contador do SKU, por organização **e por fluxo**.
///
/// Produto, serviço e peça moram na mesma tabela, separados por `kind`, e são
/// catálogos diferentes: uma sequência única faria o primeiro serviço nascer com
/// o número 47 porque existem 46 produtos.
///
/// Mesmo padrão de [PmocCodeSequence] e [ServiceOrderSequence]: linha por
/// inquilino, incrementada com `ON CONFLICT DO UPDATE` dentro da transação que
/// cria o item. A autoridade contra duplicidade continua sendo
/// `@@unique([organizationId, sku])` em `Product` — e o SKU também pode ser
/// digitado, então a alocação avança até achar livre.
model ProductSkuSequence {
  organizationId String   @map("organization_id") @db.Uuid
  /// `PRODUCT` · `SERVICE` · `PART`. Texto, como em `Product`.
  kind           String   @db.VarChar(40)
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, kind])
  @@map("product_sku_sequences")
}

model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  kind           String    @default("PRODUCT") @db.VarChar(40)
  /// O código do item. **Gerado** na criação, com contagem por fluxo:
  /// `PRD-000001` para produto, `SRV-000001` para serviço, `PEC-000001` para
  /// peça. Continua aceitando valor digitado — quem vem de outro sistema importa
  /// os códigos antigos —, e é por isso que a geração avança até achar livre.
  ///
  /// Opcional na coluna por causa do histórico: itens criados antes da geração
  /// existiam sem código, e a migração os preencheu. Nada novo nasce sem.
  sku            String?   @db.VarChar(80)
  name           String    @db.VarChar(180)
  description    String?   @db.Text
  unit           String    @default("UN") @db.VarChar(20)
  salePrice      Decimal?  @map("sale_price") @db.Decimal(14, 2)
  costPrice      Decimal?  @map("cost_price") @db.Decimal(14, 2)
  taxData        Json?     @map("tax_data") @db.JsonB
  metadata       Json?     @db.JsonB
  status         String    @default("ACTIVE") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  quoteItems         QuoteItem[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]

  @@unique([organizationId, sku])
  @@index([organizationId, kind, status, deletedAt])
  @@index([businessUnitId, status])
  @@map("products")
}

// -----------------------------------------------------------------------------
// ASSETS
// -----------------------------------------------------------------------------

/// O contador do código interno de equipamento, por organização.
///
/// Só o código interno é gerado: os outros tipos de identificador (série, QR,
/// NFC, barras, RFID) são lidos da máquina física, e gerá-los inventaria um fato
/// sobre o equipamento do cliente.
///
/// Por organização porque a unicidade do identificador também é — e porque um
/// contador global faria a primeira máquina de um inquilino novo nascer com o
/// número de outra empresa, numa etiqueta que vai colada no equipamento.
model AssetInternalCodeSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("asset_internal_code_sequences")
}

model Asset {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  category       String    @db.VarChar(80)
  name           String    @db.VarChar(180)
  manufacturer   String?   @db.VarChar(120)
  model          String?   @db.VarChar(120)
  serialNumber   String?   @map("serial_number") @db.VarChar(120)
  /// O que é o conteúdo de [identifier]: série, QR, NFC, barras, RFID ou código
  /// interno. Só o **código interno** é atribuído pela organização; os demais são
  /// lidos da máquina.
  identifierType String?   @map("identifier_type") @db.VarChar(30)
  /// O conteúdo lido da etiqueta — ou, quando o tipo é `INTERNAL_CODE` e nada foi
  /// informado, o código que o sistema gera (`EQP-000001`, por organização).
  identifier     String?   @db.VarChar(180)
  installationAt DateTime? @map("installation_at") @db.Date
  warrantyUntil  DateTime? @map("warranty_until") @db.Date
  location       String?   @db.VarChar(255)
  specifications Json?     @db.JsonB
  status         String    @default("ACTIVE") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit            BusinessUnit                   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  customer                Customer?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  operationLinks          OperationAsset[]
  quoteLinks              QuoteAsset[]
  schedulingEvents        SchedulingEvent[]
  schedulingAllocations   SchedulingResourceAllocation[]
  artifactExecutions      ArtifactExecution[]
  pmocEquipmentExecutions PmocEquipmentExecution[]
  pmocCoverages           PmocEquipmentCoverage[]
  qrIdentities            EquipmentQrIdentity[]
  customerServiceRequests CustomerServiceRequest[]

  @@unique([organizationId, identifier])
  @@index([organizationId, businessUnitId, status, deletedAt])
  @@index([organizationId, customerId])
  @@index([organizationId, serialNumber])
  @@map("assets")
}

/// Stable, physical QR identity for an Equipment. The random token is not an
/// authorization credential; every resolution still runs under authenticated
/// tenant and Business Unit RLS context.
model EquipmentQrIdentity {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  equipmentId    String    @map("equipment_id") @db.Uuid
  token          String    @unique @db.VarChar(64)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  status         String    @default("ACTIVE") @db.VarChar(20)
  metadata       Json      @default("{}") @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  equipment    Asset        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, businessUnitId, status])
  @@index([equipmentId, status])
  @@map("equipment_qr_identities")
}

// -----------------------------------------------------------------------------
// OPERATIONS
// -----------------------------------------------------------------------------

/// Os equipamentos de um atendimento.
///
/// Substitui `Operation.assetId`, que era um só. Um atendimento em campo
/// raramente toca um equipamento: o técnico vai ao endereço e atende os
/// aparelhos que estão lá, e obrigar uma ordem por aparelho multiplicava o
/// trabalho administrativo sem descrever melhor o serviço.
model OperationAsset {
  id          String   @id @default(uuid(7)) @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([operationId, assetId])
  @@index([assetId])
  @@map("operation_assets")
}

model Operation {
  id                           String    @id @default(uuid(7)) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  businessUnitId               String    @map("business_unit_id") @db.Uuid
  customerId                   String?   @map("customer_id") @db.Uuid
  /// Para onde o técnico vai. Sempre um endereço do cliente do atendimento.
  customerAddressId            String?   @map("customer_address_id") @db.Uuid
  /// O ponto exato dentro do endereço: "Auditório", "Sala 2", "Cozinha".
  sector                       String?   @db.VarChar(120)
  code                         String    @db.VarChar(60)
  /// O número da Ordem de Serviço — contagem própria, por organização.
  ///
  /// Operação é o gênero: o PMOC executa criando operação, a RVT também. OS é
  /// uma espécie, e a numeração dela é a que o cliente cobra ao telefone. Por
  /// isso não é o `code` (texto digitado pelo dono, sem contagem) nem um
  /// `COUNT` de operações, que somaria manutenções preventivas que ninguém
  /// chamou de ordem de serviço.
  ///
  /// Nulo nas operações que nascem de PMOC ou RVT: elas têm as contagens delas.
  serviceOrderNumber           Int?      @map("service_order_number")
  kind                         String    @db.VarChar(60)
  title                        String    @db.VarChar(220)
  description                  String?   @db.Text
  status                       String    @default("OPEN") @db.VarChar(40)
  priority                     String    @default("NORMAL") @db.VarChar(30)
  scheduledStart               DateTime? @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd                 DateTime? @map("scheduled_end") @db.Timestamptz(3)
  startedAt                    DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt                  DateTime? @map("completed_at") @db.Timestamptz(3)
  location                     Json?     @db.JsonB
  data                         Json?     @db.JsonB
  createdById                  String?   @map("created_by_id") @db.Uuid
  responsibleFieldTechnicianId String?   @map("responsible_field_technician_id") @db.Uuid

  /// Quando a atribuição foi autorizada, e por quem.
  ///
  /// Só importa nas organizações que ligaram
  /// `settings.operations.requireAssignmentAuthorization`. Nelas, um
  /// atendimento atribuído mas **não** autorizado não chega ao técnico: não
  /// aparece na fila do aplicativo nem responde às rotas de campo.
  ///
  /// Nulo é o estado de quem nunca precisou disso — e é por isso que a
  /// migração marca como autorizado tudo o que já existia: ligar a chave não
  /// pode esconder retroativamente o trabalho do dia.
  authorizedAt      DateTime? @map("authorized_at") @db.Timestamptz(3)
  authorizedById    String?   @map("authorized_by_id") @db.Uuid

  /// O técnico em campo pode ver quanto este atendimento vale?
  ///
  /// `false` por padrão, e a omissão é deliberada: o valor combinado com o cliente
  /// não é informação que todo técnico precise ter na mão dentro da casa do cliente,
  /// e revelá-lo retroativamente em todo atendimento que já existe seria decidir isso
  /// pelo dono. Ligar é um ato por atendimento, na tela que o configura.
  ///
  /// O valor em si não mora aqui: é o total do orçamento vinculado
  /// (`Quote.operationId`). Esta coluna governa a **visibilidade**, não o número —
  /// um segundo campo de dinheiro na operação divergiria do orçamento no primeiro
  /// reajuste.
  amountVisibleInField Boolean @default(false) @map("amount_visible_in_field")
  startedByUserId   String?   @map("started_by_user_id") @db.Uuid
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization               Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit               BusinessUnit                   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  customer                   Customer?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerAddress            CustomerAddress?               @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  assets                     OperationAsset[]
  responsibleFieldTechnician User?                          @relation("OperationResponsibleFieldTechnician", fields: [responsibleFieldTechnicianId], references: [id], onDelete: SetNull)
  authorizedBy               User?                          @relation("OperationAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  startedBy                  User?                          @relation("OperationStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedBy                User?                          @relation("OperationCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  auxiliaryTechnicians       OperationAuxiliaryTechnician[]
  users                      OperationUser[]
  history                    OperationHistory[]
  attachments                OperationAttachment[]
  reports                    Report[]
  checklistExecutions        ChecklistExecution[]
  aiExecutions               AiExecution[]
  artifactExecutions         ArtifactExecution[]
  fieldEvidenceUploads       FieldEvidenceUpload[]
  fieldEvidence              FieldEvidence[]
  sourceServiceRequest       CustomerServiceRequest?

  financialEntries FinancialEntry[]

  quote Quote?

  inventoryMovements InventoryMovement[]

  pmocExecution           PmocExecution?
  pmocEquipmentExecution  PmocEquipmentExecution?
  commissionItems         CommissionPaymentItem[]
  commissionCancellations CommissionCancellation[]

  @@index([organizationId, code])
  @@index([organizationId, businessUnitId, status, scheduledStart])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, customerAddressId])
  /// Relatórios gerenciais: "tudo da organização entre duas datas".
  @@index([organizationId, createdAt])
  @@index([organizationId, completedAt])
  @@index([organizationId, responsibleFieldTechnicianId, status, scheduledStart])
  /// A fila do técnico filtra por autorização quando a organização a exige.
  @@index([organizationId, authorizedAt])
  @@map("operations")
  cancellationRequests OperationCancellationRequest[]
}

