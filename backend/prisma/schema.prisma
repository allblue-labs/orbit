model ArtifactExecutionInsight {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  executionId    String            @map("execution_id") @db.Uuid
  kind           String            @db.VarChar(40)
  severity       String            @default("INFO") @db.VarChar(30)
  source         String            @db.VarChar(80)
  title          String            @db.VarChar(180)
  description    String            @db.Text
  payload        Json              @default("{}") @db.JsonB
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      ArtifactExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([organizationId, executionId, kind, resolvedAt])
  @@map("artifact_execution_insights")
}

/// Objeto binário guardado por um provider de armazenamento.
///
/// É a única representação de arquivo da plataforma: manifests e anexos
/// apontam para cá em vez de guardarem chave e bucket próprios. `objectKey` e
/// `bucket` são internos — nenhum Read Model os publica.
model StorageFile {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  provider       String    @db.VarChar(40)
  bucket         String    @db.VarChar(160)
  objectKey      String    @map("object_key") @db.VarChar(1024)
  fileName       String    @map("file_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(160)
  sizeBytes      BigInt    @map("size_bytes")
  /// SHA-256 do conteúdo. Nulo enquanto um upload assinado não foi confirmado.
  sha256         String?   @db.Char(64)
  /// PENDING enquanto só existe a URL de upload; AVAILABLE após confirmação.
  status         String    @default("PENDING") @db.VarChar(20)
  metadata       Json      @default("{}") @db.JsonB
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit          BusinessUnit?                 @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  createdBy             User?                         @relation("StorageFileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  manifests             ArtifactManifest[]
  managementReports     ManagementReport[]
  attachments           ArtifactExecutionAttachment[]
  pmocEquipmentEvidence PmocEquipmentEvidence[]

  memberCertifications   MemberCertification[]
  professionalSignatures UserSignature[]
  pmocSignatureLinks     PmocPlanSignatureLink[]
  userAvatars            User[]                @relation("UserAvatarFile")
  fieldEvidenceUploads   FieldEvidenceUpload[]
  fieldEvidence          FieldEvidence[]

  @@unique([provider, bucket, objectKey])
  @@index([organizationId, status, createdAt])
  @@map("storage_files")
}

/// Intenção autorizada e temporária de upload direto. Não é evidência até que
/// o objeto real seja verificado e associado transacionalmente.
model FieldEvidenceUpload {
  id                       String    @id @default(uuid(7)) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  businessUnitId           String    @map("business_unit_id") @db.Uuid
  operationId              String?   @map("operation_id") @db.Uuid
  pmocEquipmentExecutionId String?   @map("pmoc_equipment_execution_id") @db.Uuid
  rvtExecutionId           String?   @map("rvt_execution_id") @db.Uuid
  storageFileId            String    @unique @map("storage_file_id") @db.Uuid
  capturedByUserId         String    @map("captured_by_user_id") @db.Uuid
  idempotencyKey           String    @map("idempotency_key") @db.VarChar(160)
  payloadHash              String    @map("payload_hash") @db.Char(64)
  localMediaId             String?   @map("local_media_id") @db.VarChar(160)
  category                 String    @default("GENERAL") @db.VarChar(30)
  source                   String    @default("CAMERA") @db.VarChar(20)
  capturedAt               DateTime? @map("captured_at") @db.Timestamptz(3)
  expectedSha256           String?   @map("expected_sha256") @db.Char(64)
  status                   String    @default("PENDING_UPLOAD") @db.VarChar(30)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  uploadedAt               DateTime? @map("uploaded_at") @db.Timestamptz(3)
  finalizedAt              DateTime? @map("finalized_at") @db.Timestamptz(3)
  failureCode              String?   @map("failure_code") @db.VarChar(80)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  operation              Operation?              @relation(fields: [operationId], references: [id], onDelete: Cascade)
  pmocEquipmentExecution PmocEquipmentExecution? @relation(fields: [pmocEquipmentExecutionId], references: [id], onDelete: Cascade)
  rvtExecution           RvtExecution?           @relation(fields: [rvtExecutionId], references: [id], onDelete: Cascade)
  storageFile            StorageFile             @relation(fields: [storageFileId], references: [id], onDelete: Restrict)
  capturedBy             User                    @relation("FieldEvidenceUploadActor", fields: [capturedByUserId], references: [id], onDelete: Restrict)
  evidence               FieldEvidence?

  @@unique([organizationId, capturedByUserId, idempotencyKey], map: "field_evidence_upload_actor_idem_key")
  @@unique([organizationId, capturedByUserId, localMediaId], map: "field_evidence_upload_local_media_key")
  @@index([organizationId, businessUnitId, status, expiresAt])
  @@index([operationId, status])
  @@index([pmocEquipmentExecutionId, status])
  @@index([rvtExecutionId, status])
  @@map("field_evidence_uploads")
}

/// Evidência final e imutável. As três FKs opcionais são protegidas por CHECK
/// no PostgreSQL: exatamente um target sempre existe.
model FieldEvidence {
  id                       String    @id @default(uuid(7)) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  businessUnitId           String    @map("business_unit_id") @db.Uuid
  uploadId                 String    @unique @map("upload_id") @db.Uuid
  operationId              String?   @map("operation_id") @db.Uuid
  pmocEquipmentExecutionId String?   @map("pmoc_equipment_execution_id") @db.Uuid
  rvtExecutionId           String?   @map("rvt_execution_id") @db.Uuid
  /// O pedido de cancelamento que citou esta foto, quando é o caso.
  ///
  /// A evidência continua sendo **da operação** — o alvo não muda e o pipeline de
  /// upload é o mesmo. Esta coluna só registra que a foto foi apresentada como
  /// justificativa, para o dono ver as que importam em vez de todas as do
  /// atendimento.
  cancellationRequestId    String?   @map("cancellation_request_id") @db.Uuid
  storageFileId            String    @unique @map("storage_file_id") @db.Uuid
  category                 String    @db.VarChar(30)
  source                   String    @db.VarChar(20)
  fileName                 String    @map("file_name") @db.VarChar(255)
  mimeType                 String    @map("mime_type") @db.VarChar(160)
  sizeBytes                BigInt    @map("size_bytes")
  sha256                   String    @db.Char(64)
  capturedAt               DateTime? @map("captured_at") @db.Timestamptz(3)
  uploadedAt               DateTime  @map("uploaded_at") @db.Timestamptz(3)
  capturedByUserId         String    @map("captured_by_user_id") @db.Uuid
  localMediaId             String?   @map("local_media_id") @db.VarChar(160)
  status                   String    @default("FINALIZED") @db.VarChar(20)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  upload                 FieldEvidenceUpload     @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  operation              Operation?              @relation(fields: [operationId], references: [id], onDelete: Restrict)
  cancellationRequest    OperationCancellationRequest? @relation(fields: [cancellationRequestId], references: [id], onDelete: SetNull)
  pmocEquipmentExecution PmocEquipmentExecution? @relation(fields: [pmocEquipmentExecutionId], references: [id], onDelete: Restrict)
  rvtExecution           RvtExecution?           @relation(fields: [rvtExecutionId], references: [id], onDelete: Restrict)
  storageFile            StorageFile             @relation(fields: [storageFileId], references: [id], onDelete: Restrict)
  capturedBy             User                    @relation("FieldEvidenceCapturedBy", fields: [capturedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, businessUnitId, createdAt])
  @@index([operationId, createdAt])
  @@index([pmocEquipmentExecutionId, createdAt])
  @@index([rvtExecutionId, createdAt])
  @@map("field_evidence")
}

/// O pedido de cancelamento feito em campo.
///
/// ## Por que pedido, e não cancelamento
///
/// Quem está na porta descobre que não dá para atender — ninguém no local, acesso
/// negado, equipamento inacessível. Isso precisa de desfecho imediato para o técnico
/// e **nenhuma** autoridade para encerrar o compromisso: cancelar é decisão
/// comercial, e o dono pode preferir remarcar ou mandar outra pessoa.
///
/// Por isso o pedido é registro próprio, e não um estado da operação. A operação
/// segue viva enquanto o dono não decide, e o que ele decide — cancelar, reagendar,
/// reatribuir ou manter — fica em `resolution`, ao lado do motivo que o técnico deu.
///
/// ## A justificativa é obrigatória e as fotos não
///
/// A frase é o que o dono lê para decidir; sem ela o pedido não diz nada e o
/// cancelamento vira estatística sem causa. As fotos reforçam e faltam com
/// frequência legítima — chuva, pressa, bateria —, e exigi-las transformaria uma
/// recusa justa em impossível de registrar.
model OperationCancellationRequest {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  businessUnitId String @map("business_unit_id") @db.Uuid
  operationId    String @map("operation_id") @db.Uuid

  /// O que o técnico encontrou. Obrigatório.
  reason        String   @db.Text
  requestedById String   @map("requested_by_id") @db.Uuid
  requestedAt   DateTime @map("requested_at") @db.Timestamptz(3)

  /// `PENDING` enquanto o dono não decidiu; `RESOLVED` depois.
  status String @default("PENDING") @db.VarChar(20)

  /// O que o dono decidiu: `CANCELLED`, `RESCHEDULED`, `REASSIGNED` ou `DISMISSED`.
  ///
  /// `DISMISSED` é "mantenha como está" — e é uma resposta, não a ausência de uma:
  /// o técnico precisa saber que foi lido e que o atendimento continua de pé.
  resolution      String?   @db.VarChar(20)
  resolutionNotes String?   @map("resolution_notes") @db.Text
  resolvedById    String?   @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  operation    Operation    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("OperationCancellationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("OperationCancellationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// As fotos que o técnico apresentou junto do pedido.
  evidence FieldEvidence[]

  /// Os ids **locais** das capturas citadas, como o aparelho as nomeia.
  ///
  /// Guardados porque a foto quase nunca existe no servidor no instante do pedido: a
  /// captura é offline-first, e o upload acontece minutos ou horas depois. Sem esta
  /// lista não haveria como saber, na finalização daquele upload, que aquela foto
  /// pertencia a este pedido — e a citação só funcionaria com rede boa, que é quando
  /// ela menos importa.
  ///
  /// Convive com `evidence` e não a substitui: esta é a intenção declarada pelo
  /// aparelho; aquela é o que de fato chegou.
  citedLocalMediaIds String[] @map("cited_local_media_ids")

  @@index([organizationId, status, requestedAt])
  @@index([operationId, requestedAt])
  @@map("operation_cancellation_requests")
}

/// Documento oficialmente emitido pela plataforma.
///
/// Uma execução pode ter várias revisões; **uma só fica ativa**, garantido por
/// índice único parcial. O manifest não gera conteúdo: o futuro Rendering
/// Engine entrega o arquivo e o registra aqui.
model ArtifactManifest {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  businessUnitId  String    @map("business_unit_id") @db.Uuid
  executionId     String    @map("execution_id") @db.Uuid
  snapshotId      String    @map("snapshot_id") @db.Uuid
  templateId      String    @map("template_id") @db.Uuid
  templateVersion Int       @map("template_version")
  revision        Int
  status          String    @default("DRAFT") @db.VarChar(20)
  /// Identificador do renderer que produziu o conteúdo.
  renderer        String    @db.VarChar(80)
  rendererVersion String?   @map("renderer_version") @db.VarChar(40)
  format          String    @default("PDF") @db.VarChar(20)
  /// SHA-256 do arquivo emitido. Nulo enquanto a revisão é rascunho.
  contentHash     String?   @map("content_hash") @db.Char(64)
  /// SHA-256 da fonte (snapshot + respostas) no momento da emissão.
  sourceHash      String    @map("source_hash") @db.Char(64)
  fileId          String?   @map("file_id") @db.Uuid
  isActive        Boolean   @default(false) @map("is_active")
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz(3)
  issuedById      String?   @map("issued_by_id") @db.Uuid
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason   String?   @map("revoked_reason") @db.VarChar(500)
  metadata        Json      @default("{}") @db.JsonB
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  execution    ArtifactExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  snapshot     ArtifactSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  template     ArtifactTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  file         StorageFile?      @relation(fields: [fileId], references: [id], onDelete: Restrict)
  issuedBy     User?             @relation("ArtifactManifestIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  createdBy    User              @relation("ArtifactManifestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([executionId, revision])
  @@index([organizationId, executionId, revision])
  @@index([organizationId, status, issuedAt])
  @@map("artifact_manifests")
}

model ChecklistExecution {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  businessUnitId   String    @map("business_unit_id") @db.Uuid
  templateId       String    @map("template_id") @db.Uuid
  operationId      String?   @map("operation_id") @db.Uuid
  /// O checklist preenchido numa visita técnica.
  ///
  /// `operationId` já era opcional: o modelo foi feito para checklist que não
  /// pertence a uma ordem. RVT é o segundo dono, e reusar aqui traz de graça o
  /// snapshot do roteiro, as respostas, o progresso e a conclusão.
  rvtExecutionId   String?   @map("rvt_execution_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  status           String    @default("IN_PROGRESS") @db.VarChar(40)
  templateVersion  Int       @map("template_version")
  templateSnapshot Json      @map("template_snapshot") @db.JsonB
  answers          Json      @default("{}") @db.JsonB
  progress         Int       @default(0)
  notes            String?   @db.Text
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  operation    Operation?        @relation(fields: [operationId], references: [id], onDelete: SetNull)
