  templateId        String   @map("template_id") @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  templateVersion   Int      @map("template_version")
  templateKey       String   @map("template_key") @db.VarChar(100)
  templateName      String   @map("template_name") @db.VarChar(180)
  artifactType      String   @map("artifact_type") @db.VarChar(80)
  segment           String?  @db.VarChar(60)
  metadata          Json     @default("{}") @db.JsonB
  sections          Json     @default("[]") @db.JsonB
  signatureSlots    Json     @default("[]") @map("signature_slots") @db.JsonB
  layout            Json     @default("{}") @db.JsonB
  structureHash     String   @map("structure_hash") @db.Char(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ArtifactTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version      ArtifactTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  executions   ArtifactExecution[]
  manifests    ArtifactManifest[]

  @@index([organizationId, templateId, templateVersion])
  @@index([templateVersionId])
  @@map("artifact_snapshots")
}

model ArtifactExecution {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  businessUnitId    String    @map("business_unit_id") @db.Uuid
  operationId       String?   @map("operation_id") @db.Uuid
  customerId        String?   @map("customer_id") @db.Uuid
  assetId           String?   @map("asset_id") @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  snapshotId        String    @map("snapshot_id") @db.Uuid
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  createdById       String    @map("created_by_id") @db.Uuid
  code              String    @db.VarChar(80)
  title             String    @db.VarChar(220)
  status            String    @default("DRAFT") @db.VarChar(40)
  progress          Int       @default(0)
  scheduledStart    DateTime? @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd      DateTime? @map("scheduled_end") @db.Timestamptz(3)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  pausedAt          DateTime? @map("paused_at") @db.Timestamptz(3)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  notes             String?   @db.Text
  /// Estado da renderização. O backend é a autoridade — clientes só leem.
  renderStatus      String    @default("NOT_RENDERED") @map("render_status") @db.VarChar(20)
  renderRequestedAt DateTime? @map("render_requested_at") @db.Timestamptz(3)
  renderStartedAt   DateTime? @map("render_started_at") @db.Timestamptz(3)
  renderCompletedAt DateTime? @map("render_completed_at") @db.Timestamptz(3)
  /// Motivo da falha em linguagem de negócio. Nunca carrega stack nem caminho.
  renderError       String?   @map("render_error") @db.VarChar(500)
  context           Json      @default("{}") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  operation              Operation?                    @relation(fields: [operationId], references: [id], onDelete: SetNull)
  customer               Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  asset                  Asset?                        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  template               ArtifactTemplate              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  snapshot               ArtifactSnapshot              @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  responsible            User?                         @relation("ArtifactExecutionResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy              User                          @relation("ArtifactExecutionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  team                   ArtifactExecutionTeam[]
  responses              ArtifactExecutionResponse[]
  attachments            ArtifactExecutionAttachment[]
  signatures             ArtifactExecutionSignature[]
  insights               ArtifactExecutionInsight[]
  manifests              ArtifactManifest[]
  fieldArtifact          FieldArtifact?
  pmocExecution          PmocExecution?
  pmocEquipmentExecution PmocEquipmentExecution?

  @@unique([organizationId, code])
  @@index([organizationId, businessUnitId, status, createdAt])
  @@index([operationId])
  @@index([customerId])
  @@index([assetId])
  @@index([responsibleUserId, status])
  @@map("artifact_executions")
}

/// Projeção documental congelada de uma autoridade operacional de campo.
/// O renderer consome exclusivamente `snapshot`; `sourceType/sourceId` servem
/// para autorização e identidade idempotente, nunca para recompor conteúdo.
model FieldArtifact {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  businessUnitId      String   @map("business_unit_id") @db.Uuid
  sourceType          String   @map("source_type") @db.VarChar(40)
  sourceId            String   @map("source_id") @db.Uuid
  documentType        String   @map("document_type") @db.VarChar(40)
  snapshotVersion     Int      @default(1) @map("snapshot_version")
  snapshot            Json     @db.JsonB
  snapshotHash        String   @map("snapshot_hash") @db.Char(64)
  artifactExecutionId String   @unique @map("artifact_execution_id") @db.Uuid
  createdById         String   @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  artifactExecution ArtifactExecution @relation(fields: [artifactExecutionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceType, sourceId, documentType, snapshotVersion])
  @@index([organizationId, businessUnitId, createdAt])
  @@index([organizationId, sourceType, sourceId])
  @@map("field_artifacts")
}

model ArtifactExecutionTeam {
  executionId String            @map("execution_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        String            @default("MEMBER") @db.VarChar(60)
  assignedAt  DateTime          @default(now()) @map("assigned_at") @db.Timestamptz(3)
  execution   ArtifactExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([executionId, userId])
  @@index([userId, assignedAt])
  @@map("artifact_execution_team")
}

model ArtifactExecutionResponse {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  executionId    String                        @map("execution_id") @db.Uuid
  sectionId      String                        @map("section_id") @db.VarChar(120)
  fieldId        String                        @map("field_id") @db.VarChar(120)
  value          Json                          @db.JsonB
  valueType      String                        @map("value_type") @db.VarChar(80)
  unit           String?                       @db.VarChar(40)
  validations    Json                          @default("[]") @db.JsonB
  provenance     String                        @default("USER") @db.VarChar(40)
  notes          String?                       @db.Text
  answeredById   String?                       @map("answered_by_id") @db.Uuid
  answeredAt     DateTime                      @default(now()) @map("answered_at") @db.Timestamptz(3)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      ArtifactExecution             @relation(fields: [executionId], references: [id], onDelete: Cascade)
  answeredBy     User?                         @relation("ArtifactResponseAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  attachments    ArtifactExecutionAttachment[]

  @@unique([executionId, sectionId, fieldId])
  @@index([organizationId, executionId])
  @@map("artifact_execution_responses")
}

model ArtifactExecutionAttachment {
  id             String                     @id @default(uuid(7)) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  executionId    String                     @map("execution_id") @db.Uuid
  responseId     String?                    @map("response_id") @db.Uuid
  sectionId      String?                    @map("section_id") @db.VarChar(120)
  uploadedById   String                     @map("uploaded_by_id") @db.Uuid
  kind           String                     @db.VarChar(40)
  fileName       String                     @map("file_name") @db.VarChar(255)
  mimeType       String                     @map("mime_type") @db.VarChar(160)
  sizeBytes      BigInt                     @map("size_bytes")
  storageKey     String                     @unique @map("storage_key") @db.VarChar(500)
  /// Objeto no Storage. Nulo nos anexos anteriores à PR-19.
  fileId         String?                    @map("file_id") @db.Uuid
  checksum       String?                    @db.Char(64)
  metadata       Json                       @default("{}") @db.JsonB
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      ArtifactExecution          @relation(fields: [executionId], references: [id], onDelete: Cascade)
  response       ArtifactExecutionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  uploadedBy     User                       @relation("ArtifactAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  file           StorageFile?               @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, executionId, createdAt])
  @@index([fileId])
  @@index([responseId])
  @@map("artifact_execution_attachments")
}

