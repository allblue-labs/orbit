  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  resourceType   String    @map("resource_type") @db.VarChar(30)
  resourceKey    String?   @map("resource_key") @db.VarChar(160)
  kind           String    @db.VarChar(30)
  dayOfWeek      Int?      @map("day_of_week")
  date           DateTime? @db.Date
  startMinute    Int       @map("start_minute")
  endMinute      Int       @map("end_minute")
  timezone       String    @default("America/Recife") @db.VarChar(64)
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  reason         String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, businessUnitId, kind, deletedAt])
  @@index([userId, dayOfWeek, date])
  @@index([resourceType, resourceKey, dayOfWeek, date])
  @@map("scheduling_availability")
}

model SchedulingEventHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(80)
  details   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event SchedulingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@map("scheduling_event_history")
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  businessUnitId String?  @map("business_unit_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(120)
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  before         Json?    @db.JsonB
  after          Json?    @db.JsonB
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Job assíncrono processado pela própria aplicação.
///
/// O Orbit não adotou fila externa: Postgres é a infraestrutura de mensageria
/// disponível, e `FOR UPDATE SKIP LOCKED` dá exclusão mútua entre réplicas sem
/// acrescentar um componente ao deploy. A tabela é genérica de propósito —
/// renderização é o primeiro uso, não o único previsto.
model BackgroundJob {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  businessUnitId  String?   @map("business_unit_id") @db.Uuid
  /// `BUSINESS_UNIT` ou `ORGANIZATION`. Nunca derivado da ausência da unidade.
  scope           String    @db.VarChar(20)
  /// O escopo que o worker declara ao Postgres. Resolvido em quem enfileira.
  businessUnitIds String[]  @map("business_unit_ids") @db.Uuid
  queue           String    @db.VarChar(80)
  /// Chave de idempotência: enfileirar o mesmo trabalho duas vezes não duplica.
  jobKey          String    @map("job_key") @db.VarChar(200)
  payload         Json      @default("{}") @db.JsonB
  status          String    @default("PENDING") @db.VarChar(20)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3) @map("max_attempts")
  /// Quando o job volta a ser elegível — é o backoff exponencial.
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt        DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy        String?   @map("locked_by") @db.VarChar(120)
  /// Atravessa enfileiramento, execução, log e auditoria.
  correlationId   String    @map("correlation_id") @db.VarChar(64)
  /// Contexto do ator, para o worker reabrir a mesma RLS da requisição.
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  lastError       String?   @map("last_error") @db.VarChar(1000)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  @@index([queue, status, availableAt])
  @@index([organizationId, queue, status])
  @@map("background_jobs")
}

// -----------------------------------------------------------------------------
// WORKFORCE
//
// Domínio de gestão de equipe. Complementa `OrganizationMembership`, que
// responde "quem faz parte e com que papel", com o que a operação de campo
// precisa saber: o que a pessoa sabe fazer, o que ela está habilitada a fazer,
// com quem trabalha e onde esteve.
//
// Não substitui autenticação: nada aqui participa de login ou autorização.
// -----------------------------------------------------------------------------

/// Catálogo de especialidades da organização ("Refrigeração", "Elétrica").
/// É catálogo, e não texto livre no membro, para que duas pessoas com a mesma
/// especialidade sejam encontráveis pela mesma chave.
model Specialty {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(120)
  description    String?   @db.Text
  /// Classe de cor sobre tokens do Design System, escolhida pela organização.
  color          String?   @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MemberSpecialty[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("specialties")
}

/// Especialidade de uma pessoa, com o nível declarado pela organização.
model MemberSpecialty {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  specialtyId    String    @map("specialty_id") @db.Uuid
  /// JUNIOR | PLENO | SENIOR | ESPECIALISTA — declarado, não calculado.
  level          String    @default("PLENO") @db.VarChar(30)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([userId, specialtyId])
  @@index([organizationId, specialtyId, deletedAt])
  @@index([organizationId, userId, deletedAt])
  @@map("member_specialties")
}

/// Certificação de uma pessoa (NR-35, NR-10, curso de fabricante).
///
/// `expiresAt` é o que torna a certificação operacionalmente útil: quem escala
/// trabalho precisa saber quem está com a habilitação vencida. O vencimento é
/// comparado pelo **servidor**, ao listar.
model MemberCertification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String    @db.VarChar(180)
  issuer         String?   @db.VarChar(180)
  /// Número do certificado, como emitido.
  credentialId   String?   @map("credential_id") @db.VarChar(120)
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  /// Arquivo do certificado no Storage Provider (PR-19). Opcional.
  fileId         String?   @map("file_id") @db.Uuid
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         StorageFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, deletedAt])
  @@index([organizationId, expiresAt, deletedAt])
  @@map("member_certifications")
}

/// Equipe operacional. Agrupa pessoas para escala e atribuição.
model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  leaderUserId   String?   @map("leader_user_id") @db.Uuid
  name           String    @db.VarChar(140)
  slug           String    @db.VarChar(140)
  description    String?   @db.Text
  color          String?   @db.VarChar(40)
  status         String    @default("ACTIVE") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  leader       User?            @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  members      TeamMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@map("teams")
}

model TeamMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Papel dentro da equipe (texto livre: "líder técnico", "auxiliar").
  role           String?   @db.VarChar(80)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId, userId, deletedAt])
  @@map("team_memberships")
}

/// Posição reportada por uma pessoa em campo.
///
/// Escrita **apenas pela própria pessoa** (`POST /workforce/me/location`), a
/// partir do aplicativo de campo: ninguém publica a posição de outro. O
/// histórico é mantido porque a última posição sozinha não responde "onde ele
/// esteve durante a visita".
model MemberLocation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  /// Raio de incerteza em metros, como o dispositivo reportou.
  accuracy       Decimal? @db.Decimal(10, 2)
  /// Origem: MOBILE | WEB | MANUAL — para o consumidor saber o que confiar.
  source         String   @default("MOBILE") @db.VarChar(30)
  /// Quando o dispositivo mediu, que pode ser antes de quando enviou.
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, recordedAt])
  @@index([organizationId, recordedAt])
  @@map("member_locations")
}

// -----------------------------------------------------------------------------
// PROFESSIONAL IDENTITY
// -----------------------------------------------------------------------------

/// Identidade profissional tenant-scoped. Não concede permissões RBAC.
/// O perfil pertence à organização; o escopo por unidade continua sendo
/// determinado pelos BusinessUnitMemberships ativos da mesma identidade.
model ProfessionalProfile {
  id                          String   @id @default(uuid(7)) @db.Uuid
  organizationId              String   @map("organization_id") @db.Uuid
  userId                      String   @map("user_id") @db.Uuid
  fieldTechnicianEnabled      Boolean  @default(false) @map("field_technician_enabled")
  technicalResponsibleEnabled Boolean  @default(false) @map("technical_responsible_enabled")
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials  ProfessionalCredential[]

  @@unique([organizationId, userId])
  @@index([organizationId, active, fieldTechnicianEnabled])
  @@index([organizationId, active, technicalResponsibleEnabled])
  @@map("professional_profiles")
}

/// Registro emitido por conselho/autoridade. É evidência descritiva e nunca
/// concede papel profissional automaticamente.
model ProfessionalCredential {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  professionalProfileId String    @map("professional_profile_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  type                  String    @db.VarChar(20)
  registrationNumber    String    @map("registration_number") @db.VarChar(100)
  region                String?   @db.VarChar(40)
  issuingAuthority      String?   @map("issuing_authority") @db.VarChar(120)
  displayLabel          String?   @map("display_label") @db.VarChar(180)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([professionalProfileId, type, registrationNumber])
  @@index([organizationId, userId, active])
  @@map("professional_credentials")
}

/// Uma única assinatura gráfica ativa por pessoa e organização. O binário
/// vive no Storage; esta tabela mantém versão, hash e ciclo de revogação.
model UserSignature {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  storageObjectId String    @map("storage_object_id") @db.Uuid
  sha256          String    @db.Char(64)
  version         Int       @default(1)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User         @relation("ProfessionalSignatureUser", fields: [userId], references: [id], onDelete: Cascade)
  storageObject StorageFile  @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, version])
  @@index([organizationId, userId, active])
  @@map("user_signatures")
}

/// Evidência de que uma pessoa reconheceu o resumo congelado de uma execução.
/// É deliberadamente independente do Customer master e da assinatura gráfica
/// profissional do usuário.
model CustomerAcknowledgement {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  businessUnitId         String    @map("business_unit_id") @db.Uuid
  executionType          String    @map("execution_type") @db.VarChar(30)
  executionId            String    @map("execution_id") @db.Uuid
  customerId             String?   @map("customer_id") @db.Uuid
  contactId              String?   @map("contact_id") @db.Uuid
  signerName             String    @map("signer_name") @db.VarChar(180)
  signatureStorageFileId String?   @map("signature_storage_file_id") @db.Uuid
  signatureSha256        String?   @map("signature_sha256") @db.Char(64)
  contentVersion         String    @map("content_version") @db.VarChar(80)
  contentHash            String    @map("content_hash") @db.Char(64)
  summarySnapshot        Json      @map("summary_snapshot") @db.JsonB
  commandId              String    @map("command_id") @db.VarChar(120)
  payloadHash            String    @map("payload_hash") @db.Char(64)
  capturedByUserId       String    @map("captured_by_user_id") @db.Uuid
  occurredAt             DateTime? @map("occurred_at") @db.Timestamptz(3)
  acknowledgedAt         DateTime  @default(now()) @map("acknowledged_at") @db.Timestamptz(3)
  invalidatedAt          DateTime? @map("invalidated_at") @db.Timestamptz(3)
  invalidationReason     String?   @map("invalidation_reason") @db.VarChar(120)
  metadata               Json      @default("{}") @db.JsonB
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, capturedByUserId, commandId])
  @@index([organizationId, businessUnitId, executionType, executionId])
  @@index([organizationId, customerId, acknowledgedAt])
  @@index([signatureStorageFileId])
  @@map("customer_acknowledgements")
}

/// Recibo durável do protocolo offline. O payload não é persistido: somente
/// seu hash canônico e o resultado público necessário para retries seguros.
model MobileOfflineCommandReceipt {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  businessUnitId   String   @map("business_unit_id") @db.Uuid
  actorId          String   @map("actor_id") @db.Uuid
  commandId        String   @map("command_id") @db.VarChar(120)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(160)
  commandType      String   @map("command_type") @db.VarChar(60)
  aggregateType    String   @map("aggregate_type") @db.VarChar(40)
  aggregateId      String   @map("aggregate_id") @db.Uuid
  deviceInstanceId String?  @map("device_instance_id") @db.VarChar(120)
  payloadHash      String   @map("payload_hash") @db.Char(64)
  resultStatus     String   @map("result_status") @db.VarChar(30)
  result           Json     @default("{}") @db.JsonB
  serverVersion    String?  @map("server_version") @db.VarChar(80)
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([organizationId, commandId])
  @@unique([organizationId, actorId, idempotencyKey])
  @@index([organizationId, businessUnitId, processedAt])
  @@index([expiresAt])
  @@map("mobile_offline_command_receipts")
}

/// Journal de metadados para pull incremental. Snapshots públicos são
/// reconstruídos no momento da leitura, evitando duplicação de PII.
model MobileSyncChange {
  sequence        BigInt   @id @default(autoincrement())
  organizationId  String   @map("organization_id") @db.Uuid
  businessUnitId  String   @map("business_unit_id") @db.Uuid
  resourceType    String   @map("resource_type") @db.VarChar(40)
  resourceId      String   @map("resource_id") @db.VarChar(180)
  changeType      String   @map("change_type") @db.VarChar(30)
  resourceVersion String?  @map("resource_version") @db.VarChar(80)
  actorId         String?  @map("actor_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([organizationId, businessUnitId, sequence])
  @@index([organizationId, resourceType, resourceId, sequence])
  @@index([expiresAt])
  @@map("mobile_sync_changes")
}

// -----------------------------------------------------------------------------
// FINANCIAL CORE
//
// Registro de entradas e saídas de dinheiro. **Não é contabilidade**: não há
// partidas dobradas, plano de contas, conciliação bancária nem apuração
// fiscal. O que existe é o fato financeiro — entrou ou saiu, quanto, quando,
// de que categoria, com que origem.
//
// Todo lançamento pertence a **uma única unidade de negócio**: dinheiro é
// contado por unidade, e um lançamento de duas unidades seria um rateio, que
// é decisão contábil que este domínio não toma.
// -----------------------------------------------------------------------------

/// Categoria de receita ou despesa, customizável pela organização.
///
/// É catálogo, e não texto livre no lançamento, para que dois lançamentos da
/// mesma natureza sejam agrupáveis pela mesma chave — sem isso "Peças" e
/// "peças" seriam categorias diferentes no relatório.
model FinancialCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// `INCOME` · `EXPENSE` — uma categoria serve a um lado só.
  type           String    @db.VarChar(20)
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(120)
  description    String?   @db.Text
  /// Classe de cor sobre tokens do Design System.
  color          String?   @db.VarChar(40)
  /// `true` para as categorias semeadas na primeira abertura do módulo.
  isSystem       Boolean   @default(false) @map("is_system")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@unique([organizationId, type, slug])
  @@index([organizationId, type, deletedAt])
  @@map("financial_categories")
}

/// Lançamento financeiro — uma entrada ou uma saída.
///
/// ## Rastreabilidade da origem
///
/// `source` diz **de onde o fato veio** e `sourceEntityId` aponta para o
/// registro que o originou. Um lançamento de recibo carrega o id do manifest
/// que o emitiu; um manual não carrega nada. É o par que garante que o mesmo
/// recibo nunca vire dois lançamentos — ver o índice único parcial na
/// migração.
///
/// ## Cancelar não é apagar
///
/// `CANCELLED` preserva o fato de que o lançamento existiu e por que deixou de
/// valer. Apagar um valor confirmado destruiria a explicação de um saldo que
/// alguém já viu.
model FinancialEntry {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Obrigatória: dinheiro é contado por unidade.
  businessUnitId String    @map("business_unit_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  /// `INCOME` · `EXPENSE`.
  type           String    @db.VarChar(20)
  /// `PENDING` · `CONFIRMED` · `CANCELLED`.
  status         String    @default("PENDING") @db.VarChar(20)
  /// `MANUAL` · `RECEIPT` · `QUOTE` · `SYSTEM`.
  source         String    @default("MANUAL") @db.VarChar(20)
  /// Registro que originou o lançamento. Nulo em lançamento manual.
  sourceEntityId String?   @map("source_entity_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("BRL") @db.VarChar(3)
  description    String    @db.VarChar(255)
  notes          String?   @db.Text
  /// Data de competência — quando o fato aconteceu, não quando foi digitado.
  competenceDate DateTime  @map("competence_date") @db.Date
  /// Vencimento previsto, quando faz sentido. Opcional.
  dueDate        DateTime? @map("due_date") @db.Date
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String?   @map("confirmed_by_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?   @map("cancelled_by_id") @db.Uuid
  cancelReason   String?   @map("cancel_reason") @db.VarChar(500)
  customerId     String?   @map("customer_id") @db.Uuid
  operationId    String?   @map("operation_id") @db.Uuid
  metadata       Json      @default("{}") @db.JsonB
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit       @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  category     FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  operation    Operation?         @relation(fields: [operationId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("FinancialEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy  User?              @relation("FinancialEntryConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy  User?              @relation("FinancialEntryCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([organizationId, businessUnitId, competenceDate, deletedAt])
  @@index([organizationId, type, status, competenceDate])
  @@index([organizationId, categoryId, competenceDate])
  @@index([organizationId, customerId])
  @@index([organizationId, operationId])
  @@index([organizationId, source, sourceEntityId])
  @@index([organizationId, status, dueDate])
  @@map("financial_entries")
}

/// Configuração financeira da organização.
///
/// **Não é depósito de flags.** Cada campo aqui muda um comportamento que o
/// servidor de fato executa; um interruptor que ninguém lê não entra.
model FinancialSettings {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  /// Recibo oficial emitido vira receita confirmada automaticamente.
  autoRecordReceipts Boolean  @default(true) @map("auto_record_receipts")
  /// Moeda padrão dos lançamentos criados sem moeda explícita.
  defaultCurrency    String   @default("BRL") @map("default_currency") @db.VarChar(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("financial_settings")
}

// -----------------------------------------------------------------------------
// COMISSÃO DE TÉCNICOS
//
// ## A comissão pendente é derivada, não gravada
//
// Não existe tabela de comissões a pagar. Ela é calculada a partir do que já é
// verdade no banco — atendimento concluído, técnico responsável, auxiliares
// ativos, receita confirmada — cruzado com a política vigente. Materializar uma
// linha por atendimento concluído exigiria um gatilho na conclusão, e o dia em
// que ele falhasse a comissão simplesmente não existiria: ninguém procura o que
// nunca apareceu.
//
// O que **é** gravado é o pagamento. A partir dele o valor congela: `amount` no
// item é o que foi pago, e não recalcula quando a política muda. Comissão paga é
// fato histórico; comissão pendente é sempre a política de hoje.
//
// ## O que impede pagar duas vezes
//
// O índice único de `commission_payment_items` sobre
// `(organization_id, operation_id, user_id, role)`. Não é validação de
// aplicação — é o banco recusando. Dois cliques simultâneos em "pagar todas"
// terminam com um pagamento e um erro, nunca com dois pagamentos.
// -----------------------------------------------------------------------------

/// Política de comissão da organização.
///
/// Uma por organização: as regras de comissão são combinadas com a equipe, não
/// por filial. Um escopo por unidade acrescentaria uma pergunta ("de qual
/// unidade?") a toda leitura, para um caso que ninguém pediu.
model CommissionPolicy {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  /// Janela de fechamento: `WEEKLY` · `BIWEEKLY` · `MONTHLY`.
  period String @default("MONTHLY") @db.VarChar(20)
  /// `FIXED` (reais por atendimento) · `PERCENTAGE` (sobre a receita).
  mode   String @default("FIXED") @db.VarChar(20)

  /// Valor do técnico responsável: reais ou percentual, conforme `mode`.
  primaryValue   Decimal @default(0) @map("primary_value") @db.Decimal(14, 4)
  /// Valor do auxiliar. Separado porque a combinação é diferente por papel.
  assistantValue Decimal @default(0) @map("assistant_value") @db.Decimal(14, 4)

  /// Tipos de atendimento que geram comissão. Vazio significa todos.
  eligibleKinds String[] @default([]) @map("eligible_kinds") @db.VarChar(60)

  /// Só atendimento com receita confirmada gera comissão.
  ///
  /// Em `PERCENTAGE` é obrigatório na prática: sem receita não há base. Em
  /// `FIXED` é escolha — pagar pelo serviço feito ou só pelo serviço recebido.
  requiresConfirmedRevenue Boolean @default(true) @map("requires_confirmed_revenue")

  /// Desligada, nenhuma comissão é calculada e a tela diz isso.
  active Boolean @default(false)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CommissionPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("commission_policies")
}

/// Comissão que a organização decidiu não pagar.
///
/// ## Por que uma linha, e não um status na comissão
///
/// A comissão pendente é derivada — não existe linha para receber um status. O
/// cancelamento é a **decisão**, e decisão é fato: quem decidiu, quando, e por
/// quê. Guardá-la aqui deixa a derivação continuar sendo derivação.
///
/// ## Desfazer é revogar, não apagar
///
/// `revokedAt` marca a decisão desfeita, e o índice único só vale para a
/// cancelação em vigor — cancelar, desfazer e cancelar de novo é uma sequência
/// legítima, e cada passo fica registrado. Apagar a linha perderia a primeira
/// decisão, que é justamente o que alguém vai querer explicar depois.
model CommissionCancellation {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  operationId    String @map("operation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  /// `PRIMARY` (responsável) · `ASSISTANT` (auxiliar).
  role           String @db.VarChar(20)

  reason String? @db.VarChar(500)

  cancelledById String   @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime @default(now()) @map("cancelled_at") @db.Timestamptz(3)

  /// Quando a própria cancelação foi desfeita.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation    Operation    @relation(fields: [operationId], references: [id], onDelete: Restrict)
  user         User         @relation("CommissionCancellationUser", fields: [userId], references: [id], onDelete: Restrict)
  cancelledBy  User         @relation("CommissionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("CommissionCancellationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  /// O índice único em vigor é criado na migração, com `WHERE revoked_at IS NULL`.
  @@index([organizationId, operationId, userId, role])
  @@index([organizationId, userId, cancelledAt])
  @@map("commission_cancellations")
}

/// Pagamento de comissão a uma pessoa.
///
/// `amount` é a soma dos itens, calculada pelo servidor. O cliente nunca envia
/// valor: enviar o que se vai pagar seria deixar o pagador decidir o preço.
model CommissionPayment {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  businessUnitId String? @map("business_unit_id") @db.Uuid
  /// Quem recebe.
  userId         String  @map("user_id") @db.Uuid

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("BRL") @db.VarChar(3)
  /// `PIX` · `TRANSFER` · `CASH` · `PAYROLL` · `OTHER`.
  method   String? @db.VarChar(20)
  notes    String? @db.Text

  /// Recorte que o pagamento fecha, quando foi pago por período.
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  paidAt      DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?           @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  user         User                    @relation("CommissionPaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("CommissionPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        CommissionPaymentItem[]

  @@index([organizationId, userId, paidAt])
  @@map("commission_payments")
}

/// A comissão de um atendimento, congelada no pagamento.
///
/// `role` distingue o técnico responsável do auxiliar: a mesma pessoa pode
/// receber pelos dois papéis em atendimentos diferentes, e o valor é outro.
model CommissionPaymentItem {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  paymentId      String @map("payment_id") @db.Uuid
  operationId    String @map("operation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  /// `PRIMARY` (responsável) · `ASSISTANT` (auxiliar).
  role           String @db.VarChar(20)

  /// Como foi calculado, para o histórico não depender da política de hoje.
  mode       String   @db.VarChar(20)
  rate       Decimal  @db.Decimal(14, 4)
  /// Receita considerada, quando percentual.
  baseAmount Decimal? @map("base_amount") @db.Decimal(14, 2)
  amount     Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  operation    Operation         @relation(fields: [operationId], references: [id], onDelete: Restrict)
  user         User              @relation("CommissionPaymentItemUser", fields: [userId], references: [id], onDelete: Restrict)

  /// O que impede pagar a mesma comissão duas vezes.
  @@unique([organizationId, operationId, userId, role])
  @@index([organizationId, userId, createdAt])
  @@map("commission_payment_items")
}

// -----------------------------------------------------------------------------
// COMMERCIAL ENGINE — QUOTES
//
// Proposta comercial: o que se ofereceu, por quanto, até quando. **Não é
// pedido, nem contrato, nem nota fiscal** — é o documento que antecede a
// decisão do cliente, e cuja aprovação passa a valer como receita prevista.
// -----------------------------------------------------------------------------

/// Orçamento.
///
/// ## Dinheiro é do servidor
///
/// `subtotal`, `discount` e `total` são recalculados a cada mudança de item.
/// Nenhum deles é aceito do cliente: um total enviado pela rede é um total que
/// alguém pode escolher.
///
/// ## Conversão é fato, não estado
///
/// Ter virado operação não é um status — é `operationId` preenchido. Um
/// orçamento aprovado e convertido continua aprovado; o que mudou é que existe
/// trabalho a fazer por causa dele.
model Quote {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  businessUnitId    String    @map("business_unit_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  /// Sequencial por organização, atribuído sob trava — nunca se repete.
  number            Int
  /// Identificador legível derivado do número (`ORC-000042`).
  code              String    @db.VarChar(40)
  /// `DRAFT` · `SENT` · `APPROVED` · `REJECTED` · `EXPIRED` · `CANCELLED`.
  status            String    @default("DRAFT") @db.VarChar(20)
  title             String    @db.VarChar(220)
  notes             String?   @db.Text
  /// O parágrafo de abertura da proposta ("Atendendo à honrosa solicitação…").
  ///
  /// Campo do orçamento, e não constante do gerador: é texto que a empresa
  /// negocia caso a caso, e um padrão no código obrigaria a mexer no código
  /// para mudar uma frase. Nulo imprime o padrão.
  introText         String?   @map("intro_text") @db.Text
  /// Endereço de execução, entre os cadastrados do cliente.
  ///
  /// Antes disso o documento imprimia o primeiro endereço do cliente, o que
  /// para quem tem duas filiais era um chute com aparência de dado.
  serviceAddressId  String?   @map("service_address_id") @db.Uuid
  /// Quem responde tecnicamente pela proposta, e de quem sai a assinatura.
  ///
  /// Separado de `createdById`: quem digita não é necessariamente quem assina,
  /// e a assinatura impressa tem de ser a de quem responde.
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// Última data em que a proposta vale. Sem hora: validade é dia.
  validUntil        DateTime? @map("valid_until") @db.Date
  currency          String    @default("BRL") @db.VarChar(3)
  /// Soma dos itens. Recalculado pelo servidor.
  subtotal          Decimal   @default(0) @db.Decimal(14, 2)
  /// Desconto sobre o total do orçamento, além dos descontos por item.
  discount          Decimal   @default(0) @db.Decimal(14, 2)
  /// Por que houve desconto. Separado de `notes`, que é o objeto da proposta:
  /// a justificativa comercial não é parte do serviço contratado.
  discountReason    String?   @map("discount_reason") @db.VarChar(500)
  total             Decimal   @default(0) @db.Decimal(14, 2)

  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  sentById      String?   @map("sent_by_id") @db.Uuid
  /// Momento da decisão do cliente — aprovação ou recusa.
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  /// Motivo da recusa ou do cancelamento. Preservado; nunca sobrescrito por edição.
  closingReason String?   @map("closing_reason") @db.VarChar(500)
  expiredAt     DateTime? @map("expired_at") @db.Timestamptz(3)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Operação gerada pela conversão. Nulo enquanto não converteu.
  operationId String?   @unique @map("operation_id") @db.Uuid
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(3)

  metadata    Json      @default("{}") @db.JsonB
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  operation      Operation?       @relation(fields: [operationId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sentBy         User?            @relation("QuoteSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  decidedBy      User?            @relation("QuoteDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// `SetNull`: apagar o endereço não pode apagar a proposta que o citou.
  serviceAddress CustomerAddress? @relation(fields: [serviceAddressId], references: [id], onDelete: SetNull)
  responsible    User?            @relation("QuoteResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  assets         QuoteAsset[]

  @@unique([organizationId, number])
  @@index([organizationId, businessUnitId, status, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, status, validUntil])
  @@map("quotes")
}

/// Os equipamentos que a proposta cobre.
///
/// Pelo mesmo motivo de `OperationAsset`: um orçamento de manutenção raramente
/// trata de um aparelho só, e obrigar uma proposta por equipamento
/// multiplicaria o trabalho comercial sem descrever melhor o escopo.
///
/// É vínculo, não fotografia: diferente de `QuoteItem`, aqui o que interessa é
/// *qual* aparelho, e o cadastro do aparelho é a fonte viva desse dado.
model QuoteAsset {
  id        String   @id @default(uuid(7)) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([quoteId, assetId])
  @@index([assetId])
  @@map("quote_assets")
}

/// Item de um orçamento — **cópia comercial**, não referência viva.
///
/// Descrição, SKU, unidade e preço são gravados no momento em que o item entra.
/// `catalogItemId` guarda de onde veio, para rastreabilidade, mas o orçamento
/// não o lê para exibir nada: mudar o preço no Catálogo amanhã não pode mudar
/// o que já foi proposto a um cliente — e um preço que muda depois de enviado
/// é uma proposta que ninguém pode honrar.
model QuoteItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  /// Origem no Catálogo. `SetNull` para que apagar o produto não apague o item.
  catalogItemId  String?  @map("catalog_item_id") @db.Uuid
  /// `PRODUCT` · `SERVICE` · `PART`, congelado na inclusão.
  kind           String   @default("PRODUCT") @db.VarChar(40)
  description    String   @db.VarChar(255)
  sku            String?  @db.VarChar(80)
  unit           String   @default("UN") @db.VarChar(20)
  /// Três casas: serviço se mede em horas, e meia hora existe.
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  /// `quantity * unitPrice - discount`, calculado pelo servidor.
  total          Decimal  @db.Decimal(14, 2)
  notes          String?  @db.Text
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItem  Product?     @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
  @@index([organizationId, catalogItemId])
  @@map("quote_items")
}

// -----------------------------------------------------------------------------
// INVENTORY ENGINE
//
// **Estoque não é um número que se edita.** O saldo é consequência de
// movimentações, e só delas. Não existe rota que escreva quantidade: quem
// quiser mudar o saldo registra um movimento, e o movimento fica.
//
//   CatalogItem ──▶ InventoryMovement (ledger) ──▶ InventoryBalance (projeção)
//
// A projeção existe por desempenho — perguntar "quanto tem" não pode custar a
// soma de todo o histórico. Ela nunca é fonte independente: cada movimento a
// atualiza na mesma transação, e `balanceAfter` guarda o resultado para que
// divergência entre as duas seja detectável.
// -----------------------------------------------------------------------------

/// Um fato de estoque. **Append-only.**
///
/// Movimento confirmado não é editado nem apagado — corrigir saldo é
/// registrar outro movimento. Apagar uma linha para consertar um número
/// destruiria a explicação de um saldo que alguém já conferiu, e é
/// exatamente o que um livro de estoque existe para impedir.
model InventoryMovement {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  /// Estoque é da unidade: o mesmo item tem saldos diferentes em filiais diferentes.
  businessUnitId    String   @map("business_unit_id") @db.Uuid
  catalogItemId     String   @map("catalog_item_id") @db.Uuid
  /// `ENTRY` · `CONSUMPTION` · `RETURN` · `ADJUSTMENT_IN` · `ADJUSTMENT_OUT` · `TRANSFER_IN` · `TRANSFER_OUT`
  type              String   @db.VarChar(20)
  /// Sempre positiva. A direção é dada por `type`, nunca pelo sinal.
  quantity          Decimal  @db.Decimal(14, 3)
  /// Saldo da unidade logo depois deste movimento, gravado na mesma instrução.
  balanceAfter      Decimal  @map("balance_after") @db.Decimal(14, 3)
  reason            String?  @db.VarChar(500)
  notes             String?  @db.Text
  /// Operação que consumiu ou devolveu o material.
  operationId       String?  @map("operation_id") @db.Uuid
  /// Procedência: `MANUAL` quando alguém digitou; outro registro quando derivado.
  source            String   @default("MANUAL") @db.VarChar(20)
  sourceEntityId    String?  @map("source_entity_id") @db.Uuid
  /// Identidade compartilhada pelas duas pontas de uma transferência.
  transferId        String?  @map("transfer_id") @db.Uuid
  /// Unidade da outra ponta, para que cada lado saiba de onde veio ou para onde foi.
  counterpartUnitId String?  @map("counterpart_unit_id") @db.Uuid
  createdById       String   @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  catalogItem  Product      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  operation    Operation?   @relation(fields: [operationId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, businessUnitId, catalogItemId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, operationId])
  @@index([organizationId, source, sourceEntityId])
  @@index([transferId])
  @@map("inventory_movements")
}

/// Saldo atual de um item numa unidade — **projeção**, não verdade autônoma.
///
/// `minimumStock` mora aqui porque o mínimo é do par item+unidade: a filial que
/// atende hospital precisa de mais filtro em casa que a que atende escritório.
model InventoryBalance {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  catalogItemId  String    @map("catalog_item_id") @db.Uuid
  /// Quantidade física. Nunca negativa — garantido por `CHECK`.
  onHand         Decimal   @default(0) @map("on_hand") @db.Decimal(14, 3)
  /// Comprometido e ainda não consumido.
  ///
  /// **Nada escreve nesta coluna hoje.** É a fundação para reservas: existe
  /// para que o contrato já publique `available = onHand - reserved` e a PR que
  /// implementar reserva não precise reformatar projeção nem Read Model.
  reserved       Decimal   @default(0) @db.Decimal(14, 3)
  /// Abaixo disto o item é considerado baixo. `0` significa "sem mínimo definido".
  minimumStock   Decimal   @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  /// Último movimento que alterou este saldo — âncora de conferência.
  lastMovementAt DateTime? @map("last_movement_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  catalogItem  Product      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, catalogItemId])
  @@index([organizationId, businessUnitId])
  @@index([organizationId, catalogItemId])
  @@map("inventory_balances")
}

// -----------------------------------------------------------------------------
// AUTOMATION ENGINE
//
//   Domain Event ──▶ Automation Rule ──▶ Conditions ──▶ Actions
//
// **Não há script.** Uma regra é dado: gatilho conhecido, condições
// declarativas com quatro operadores, e ações de um catálogo fechado. Nada aqui
// executa expressão, JavaScript, SQL ou template — a superfície de uma regra é
// exatamente o que o servidor sabe interpretar.
// -----------------------------------------------------------------------------

/// Um fato que aconteceu no domínio. **Append-only.**
///
/// É o outbox: gravado na mesma transação do fato que o originou, junto com o
/// job que o levará adiante. Um processo que morra entre o commit e o
/// enfileiramento não perde o evento.
///
/// `payload` carrega o **mínimo necessário** para as condições — nunca a
/// entidade Prisma inteira. Serializar o registro completo transformaria o
/// evento num retrato que envelhece e vaza campo que ninguém pediu.
model DomainEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessUnitId String?  @map("business_unit_id") @db.Uuid
  /// `operation.completed`, `quote.approved`… — catálogo fechado no código.
  type           String   @db.VarChar(80)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId        String?  @map("actor_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(60)
  entityId       String   @map("entity_id") @db.Uuid
  /// Versão do formato do payload. Consumidor antigo sabe o que não entende.
  payloadVersion Int      @default(1) @map("payload_version")
  payload        Json     @default("{}") @db.JsonB
  /// Atravessa o fluxo inteiro: emissão, despacho, ação, log.
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId, type, occurredAt])
  @@index([organizationId, entityType, entityId])
  @@map("domain_events")
}

/// Uma regra: quando isto acontecer, e se for assim, faça aquilo.
model AutomationRule {
  id                   String    @id @default(uuid(7)) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  /// Nula = vale para toda a organização; preenchida = só naquela unidade.
  businessUnitId       String?   @map("business_unit_id") @db.Uuid
  /// Snapshot fail-closed das unidades autorizadas na configuração.
  scopeBusinessUnitIds String[]  @default([]) @map("scope_business_unit_ids") @db.Uuid
  name                 String    @db.VarChar(180)
  description          String?   @db.Text
  enabled              Boolean   @default(true)
  /// Tipo de evento que dispara a regra.
  trigger              String    @db.VarChar(80)
  /// Lista de condições declarativas, todas verdadeiras para a regra valer.
  conditions           Json      @default("[]") @db.JsonB
  /// Lista de ações, cada uma com tipo, atraso e configuração própria.
  actions              Json      @default("[]") @db.JsonB
  createdById          String    @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit?         @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  executions   AutomationExecution[]

  @@index([organizationId, trigger, enabled, deletedAt])
  @@index([organizationId, businessUnitId])
  @@map("automation_rules")
}

/// Uma ação de uma regra sobre uma ocorrência — **uma linha, para sempre**.
///
/// É aqui que a idempotência mora. A unicidade
/// `(evento, regra, ação)` é do banco: retry da fila, job devolvido por tempo
/// limite e reprocessamento manual convergem para **um** efeito. Sem ela, um
/// lembrete de seis meses viraria dois na primeira reentrega.
///
/// A linha é reivindicada antes de a ação rodar e só é fechada depois. Falha
/// deixa `FAILED`, que **pode** ser retomado; `SUCCEEDED` nunca é.
model AutomationExecution {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  /// Identificador da ação dentro da regra — posição estável na lista.
  actionId       String    @map("action_id") @db.VarChar(60)
  actionType     String    @map("action_type") @db.VarChar(60)
  /// `PENDING` · `RUNNING` · `SUCCEEDED` · `FAILED` · `SKIPPED`.
  status         String    @default("PENDING") @db.VarChar(20)
  attempts       Int       @default(0)
  /// Quando a ação foi programada para acontecer — o atraso, materializado.
  scheduledFor   DateTime? @map("scheduled_for") @db.Timestamptz(3)
  executedAt     DateTime? @map("executed_at") @db.Timestamptz(3)
  /// O que a ação criou: id do lembrete, da notificação, da operação.
  resultType     String?   @map("result_type") @db.VarChar(60)
  resultId       String?   @map("result_id") @db.Uuid
  /// Motivo do descarte ou da falha, em linguagem de negócio.
  detail         String?   @db.VarChar(500)
  correlationId  String    @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        DomainEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([eventId, ruleId, actionId])
  @@index([organizationId, status, createdAt])
  @@index([ruleId, createdAt])
  @@map("automation_executions")
}

/// Relatório gerencial gerado — o snapshot **é** o relatório.
///
/// Um relatório histórico continua representando os números do momento em que
/// foi gerado: `data` é imutável depois de `READY`, e nenhuma leitura
/// recalcula. Mudar o operacional depois muda o próximo relatório, não este.
model ManagementReport {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Nulo = organização inteira. Preenchido = recorte da unidade.
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  /// Tipo canônico do catálogo fechado.
  type           String    @db.VarChar(60)
  /// Versão do formato de `data`. Um leitor antigo precisa poder recusar.
  schemaVersion  Int       @default(1) @map("schema_version")
  status         String    @default("PENDING") @db.VarChar(20)
  format         String    @default("PDF") @db.VarChar(20)
  /// Parâmetros efetivamente usados, já resolvidos pelo servidor.
  parameters     Json      @default("{}") @db.JsonB
  /// SHA-256 dos parâmetros normalizados — identidade da solicitação.
  parametersHash String    @map("parameters_hash") @db.Char(64)
  /// O snapshot: seções, métricas e tabelas. Nulo enquanto não compôs.
  data           Json?     @db.JsonB
  /// SHA-256 do snapshot — duas renderizações do mesmo snapshot são iguais.
  sourceHash     String?   @map("source_hash") @db.Char(64)
  /// Fontes usadas e a qualidade de cada uma (OBSERVED/DERIVED/PROXY/MOCK).
  provenance     Json      @default("[]") @db.JsonB
  /// Fuso do recorte, resolvido da unidade — nunca do navegador.
  timezone       String    @db.VarChar(64)
  periodFrom     DateTime  @map("period_from") @db.Timestamptz(3)
  periodTo       DateTime  @map("period_to") @db.Timestamptz(3)
  generatedAt    DateTime? @map("generated_at") @db.Timestamptz(3)
  generatedById  String    @map("generated_by_id") @db.Uuid
  /// Arquivo emitido, quando houve renderização.
  fileId         String?   @map("file_id") @db.Uuid
  renderer       String?   @db.VarChar(80)
  /// Motivo da falha em linguagem de negócio. Nunca carrega stack.
  error          String?   @db.VarChar(500)
  attempts       Int       @default(0)
  correlationId  String    @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  generatedBy  User          @relation("ManagementReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  file         StorageFile?  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId, type, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, businessUnitId, createdAt])
  @@index([organizationId, generatedById, createdAt])
  @@map("management_reports")
}

// -----------------------------------------------------------------------------
// PMOC & COMPLIANCE
// -----------------------------------------------------------------------------

/// Plano de Manutenção, Operação e Controle.
///
/// O plano existe **independentemente do documento**: ele é o compromisso de
/// manter um conjunto de equipamentos com uma periodicidade, e continua valendo
/// mesmo que nenhum PDF tenha sido emitido ainda.
model PmocPlan {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  businessUnitId String  @map("business_unit_id") @db.Uuid
  customerId     String  @map("customer_id") @db.Uuid
  /// Identificador legível, único por organização.
  code           String  @db.VarChar(60)
  name           String  @db.VarChar(220)
  status         String  @default("DRAFT") @db.VarChar(20)
  notes          String? @db.Text

  /// Vigência. `endsOn` nulo = sem prazo final.
  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime? @map("ends_on") @db.Date

  /// Periodicidade: quantidade + unidade. Meses e anos são de calendário.
  frequencyAmount Int    @map("frequency_amount")
  frequencyUnit   String @map("frequency_unit") @db.VarChar(10)

  /// Antecedência, em dias, para o plano entrar em "próximo do vencimento".
  dueSoonDays Int @default(15) @map("due_soon_days")

  /// Responsável técnico — referência **operacional**, não registro profissional.
  technicianUserId String? @map("technician_user_id") @db.Uuid

  /// Responsável técnico profissional (PR-27). O campo anterior permanece
  /// apenas para leitura de históricos legados.
  technicalResponsibleUserId String? @map("technical_responsible_user_id") @db.Uuid
  serviceLocation            Json?   @map("service_location") @db.JsonB
  scope                      Json?   @db.JsonB
  serviceTypes               Json    @default("[]") @map("service_types") @db.JsonB
  procedure                  Json    @default("{}") @db.JsonB
  schedulingPaused           Boolean @default(false) @map("scheduling_paused")
  reviewRequired             Boolean @default(false) @map("review_required")

  /// Derivados mantidos pelo servidor, nunca escritos pelo cliente.
  lastExecutedAt DateTime? @map("last_executed_at") @db.Timestamptz(3)
  nextDueOn      DateTime? @map("next_due_on") @db.Date

  /// Para qual vencimento cada aviso já foi emitido — idempotência dos eventos.
  dueSoonNotifiedFor DateTime? @map("due_soon_notified_for") @db.Date
  overdueNotifiedFor DateTime? @map("overdue_notified_for") @db.Date

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit         BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  customer             Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician           User?        @relation("PmocPlanTechnician", fields: [technicianUserId], references: [id], onDelete: SetNull)
  technicalResponsible User?        @relation("PmocPlanTechnicalResponsible", fields: [technicalResponsibleUserId], references: [id], onDelete: SetNull)
  createdBy            User         @relation("PmocPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  coverages           PmocEquipmentCoverage[]
  executions          PmocExecution[]
  equipmentExecutions PmocEquipmentExecution[]
  units               PmocPlanUnit[]
  signatureLinks      PmocPlanSignatureLink[]

  @@index([organizationId, status, nextDueOn])
  @@index([organizationId, businessUnitId, status])
  @@index([organizationId, customerId])
  @@map("pmoc_plans")
}

/// O contador do código sugerido, por cliente.
///
/// Não é `COUNT(*) + 1`: a unicidade do código é parcial (só vale onde
/// `deletedAt IS NULL`), então contar planos devolveria um número já usado
/// assim que alguém apagasse um. Também não é uma SEQUENCE por cliente, que
/// seria DDL criado em runtime. É um contador persistido, incrementado dentro
/// da transação do create — atômico sob concorrência e sem reuso.
model PmocCodeSequence {
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([organizationId, customerId])
  @@map("pmoc_code_sequences")
}

/// Um equipamento coberto por um plano.
///
/// Guarda **o vínculo**, não o equipamento: nome, modelo e número de série
/// continuam sendo do `Asset`, e copiá-los aqui criaria uma segunda verdade que
/// envelhece na primeira correção de cadastro.
model PmocEquipmentCoverage {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                PmocPlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  asset               Asset                    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  equipmentExecutions PmocEquipmentExecution[]

  @@index([organizationId, planId])
  @@index([organizationId, assetId])
  @@map("pmoc_equipment_coverages")
}

/// Um ciclo do plano: a manutenção prevista para uma data.
///
/// É a **programação**, e é onde a execução real se pendura — a ordem de
/// serviço que a cumpriu e a execução de artefato que a documentou. Sem ela não
/// haveria como responder "quando foi a última" nem impedir duas ordens para o
/// mesmo vencimento.
/// Uma unidade do sistema que recebe manutenção.
///
/// Condensadora, evaporadora, dutos, torre. É o nível em que o PMOC descreve
/// o serviço: o relatório final lista, por unidade, o que foi feito nela.
///
/// ## Unidade não é equipamento
///
/// `Asset` é a máquina sob contrato — "Split Cassete 1, Sala 1". Unidade é a
/// **parte** dessa máquina que recebe manutenção, e cada parte tem o seu
/// roteiro. Um plano cobre equipamentos (que existem no cliente) e declara
/// unidades (que descrevem o serviço).
///
/// O nome é o do mercado: foi assim que as empresas que usam PMOC pediram.
model PmocUnit {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  key            String  @db.VarChar(60)
  name           String  @db.VarChar(160)
  description    String? @db.Text

  /// O roteiro desta unidade. Opcional: uma unidade recém-cadastrada ainda
  /// não tem checklist, e recusar o cadastro por isso impediria o caminho
  /// natural — criar a unidade, depois escrever o roteiro dela.
  checklistTemplateId String? @map("checklist_template_id") @db.Uuid

  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  plans             PmocPlanUnit[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive, deletedAt])
  @@index([checklistTemplateId])
  @@map("pmoc_units")
}

/// As unidades declaradas por um plano.
/// Link temporário para o contratante ler o contrato e assiná-lo.
///
/// ## Por que um registro, e não só um token assinado
///
/// Porque ele guarda a prova. Um JWT diria "este token é válido"; o que o contrato
/// precisa responder depois é "quem assinou, quando, de onde" — e isso é linha de
/// banco. A assinatura coletada vive aqui, e é daqui que o documento do PMOC a lê.
///
/// ## Um pendente por plano
///
/// `pmoc_signature_links_pending_unique` é parcial: vale só enquanto o link não foi
/// revogado nem assinado. Gerar um link novo revoga o anterior — pedido explícito do
/// produto, e a razão é de segurança: um link antigo circulando por e-mail continuaria
/// abrindo o contrato depois de o dono ter decidido gerar outro.
///
/// Links já assinados não entram no índice, então eles permanecem como histórico e não
/// impedem uma nova coleta.
///
/// ## O token não é guardado
///
/// Só o SHA-256 dele, como em `customer_portal_invitations`. Vazando o banco, ninguém
/// assina em nome de ninguém: o segredo existe uma vez, na resposta que o dono copia.
model PmocPlanSignatureLink {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Quando o contratante assinou. Nulo enquanto o link está pendente.
  signedAt DateTime? @map("signed_at") @db.Timestamptz(3)
  /// Quem declarou assinar — nome e documento são digitados por ele.
  signerName     String? @map("signer_name") @db.VarChar(180)
  signerDocument String? @map("signer_document") @db.VarChar(40)
  signerEmail    String? @map("signer_email") @db.VarChar(180)
  /// Evidência de onde veio o aceite. Não identifica ninguém sozinha, e é o que
  /// sobra para contestar uma assinatura meses depois.
  signedIp        String? @map("signed_ip") @db.VarChar(64)
  signedUserAgent String? @map("signed_user_agent") @db.VarChar(400)

  /// A imagem da assinatura, no storage — como as assinaturas profissionais.
  signatureFileId String? @map("signature_file_id") @db.Uuid
  signatureSha256 String? @map("signature_sha256") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan          PmocPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("PmocSignatureLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  signatureFile StorageFile? @relation(fields: [signatureFileId], references: [id], onDelete: Restrict)

  @@index([organizationId, planId, createdAt])
  @@index([planId, signedAt])
  @@map("pmoc_plan_signature_links")
}

model PmocPlanUnit {
  id        String   @id @default(uuid(7)) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan PmocPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  unit PmocUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([planId, unitId])
  @@index([unitId])
  @@map("pmoc_plan_units")
}

/// Nomes sugeridos para um plano de PMOC.
///
/// Catálogo **da plataforma**, não da organização: são os nomes que a norma e
/// o mercado usam, iguais para todo inquilino. Por isso não tem
/// `organizationId` e não tem RLS — mesma forma de `Plan`.
///
/// Quem precisa de um nome fora da lista escolhe "Outros" no formulário e
/// digita o seu; esse texto vai para `PmocPlan.name` como sempre foi, e não
/// entra aqui. O catálogo é sugestão, não restrição.
model PmocPlanNameOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(60)
  label     String   @db.VarChar(160)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("pmoc_plan_name_options")
}

model PmocExecution {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  /// Vencimento previsto deste ciclo.
  dueOn          DateTime @map("due_on") @db.Date
  status         String   @default("PENDING") @db.VarChar(20)
  sequenceNumber Int      @default(1) @map("sequence_number")

  /// A ordem de serviço que cumpriu o ciclo. Única: um ciclo, uma ordem.
  operationId         String? @unique @map("operation_id") @db.Uuid
  /// A evidência documental — execução de artefato real, nunca fabricada.
  artifactExecutionId String? @unique @map("artifact_execution_id") @db.Uuid
  /// O compromisso na Agenda existente. Nunca uma agenda paralela.
  schedulingEventId   String? @unique @map("scheduling_event_id") @db.Uuid

  performedAt   DateTime? @map("performed_at") @db.Timestamptz(3)
  completedById String?   @map("completed_by_id") @db.Uuid
  notes         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                PmocPlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  operation           Operation?               @relation(fields: [operationId], references: [id], onDelete: SetNull)
  artifactExecution   ArtifactExecution?       @relation(fields: [artifactExecutionId], references: [id], onDelete: SetNull)
  schedulingEvent     SchedulingEvent?         @relation(fields: [schedulingEventId], references: [id], onDelete: SetNull)
  completedBy         User?                    @relation("PmocExecutionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  equipmentExecutions PmocEquipmentExecution[]

  @@unique([planId, dueOn])
  @@unique([planId, sequenceNumber])
  @@index([organizationId, planId, dueOn])
  @@index([organizationId, status, dueOn])
  @@map("pmoc_executions")
}

/// Execução física de um equipamento em um ciclo PMOC. O índice composto é a
/// autoridade contra duas execuções para o mesmo equipamento e vencimento.
model PmocEquipmentExecution {
  id                           String    @id @default(uuid(7)) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  businessUnitId               String    @map("business_unit_id") @db.Uuid
  cycleId                      String    @map("cycle_id") @db.Uuid
  /// Denormalizado do ciclo para que a contagem por equipamento possa ser
  /// garantida por índice. Sai sempre da mesma preparação que cria a linha.
  planId                       String    @map("plan_id") @db.Uuid
  coverageId                   String    @map("coverage_id") @db.Uuid
  assetId                      String    @map("asset_id") @db.Uuid
  /// A posição desta execução na história **deste equipamento** neste plano.
  ///
  /// Não é o número do ciclo: um equipamento que entra no plano depois, ou que
  /// fica de fora de um ciclo, tem contagem própria. É o número que o relatório
  /// de execução imprime.
  sequenceNumber               Int       @map("sequence_number")
  operationId                  String?   @unique @map("operation_id") @db.Uuid
  artifactExecutionId          String?   @unique @map("artifact_execution_id") @db.Uuid
  responsibleFieldTechnicianId String    @map("responsible_field_technician_id") @db.Uuid
  status                       String    @default("IN_PROGRESS") @db.VarChar(24)
  performedAt                  DateTime? @map("performed_at") @db.Timestamptz(3)
  procedureSnapshot            Json      @map("procedure_snapshot") @db.JsonB
  technicalResponsibleSnapshot Json      @map("technical_responsible_snapshot") @db.JsonB
  notes                        String?   @db.VarChar(1000)
  startedById                  String    @map("started_by_id") @db.Uuid
  completedById                String?   @map("completed_by_id") @db.Uuid
  startedAt                    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt                  DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit               BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  cycle                      PmocExecution           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  plan                       PmocPlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  coverage                   PmocEquipmentCoverage   @relation(fields: [coverageId], references: [id], onDelete: Restrict)
  asset                      Asset                   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  operation                  Operation?              @relation(fields: [operationId], references: [id], onDelete: SetNull)
  artifactExecution          ArtifactExecution?      @relation(fields: [artifactExecutionId], references: [id], onDelete: SetNull)
  responsibleFieldTechnician User                    @relation("PmocEquipmentExecutionResponsible", fields: [responsibleFieldTechnicianId], references: [id], onDelete: Restrict)
  startedBy                  User                    @relation("PmocEquipmentExecutionStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  completedBy                User?                   @relation("PmocEquipmentExecutionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  evidence                   PmocEquipmentEvidence[]
  fieldEvidenceUploads       FieldEvidenceUpload[]
  fieldEvidence              FieldEvidence[]

  @@unique([cycleId, coverageId])
  /// A autoridade contra duas execuções com o mesmo número para o mesmo
  /// equipamento — o que torna `max+1` seguro sob concorrência.
  @@unique([planId, assetId, sequenceNumber])
  @@index([organizationId, planId, assetId, sequenceNumber])
  @@index([organizationId, cycleId, status])
  @@index([organizationId, responsibleFieldTechnicianId, status])
  @@map("pmoc_equipment_executions")
}

model PmocEquipmentEvidence {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  equipmentExecutionId String   @map("equipment_execution_id") @db.Uuid
  storageFileId        String   @map("storage_file_id") @db.Uuid
  kind                 String   @default("PHOTO") @db.VarChar(24)
  caption              String?  @db.VarChar(500)
  uploadedById         String   @map("uploaded_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipmentExecution PmocEquipmentExecution @relation(fields: [equipmentExecutionId], references: [id], onDelete: Cascade)
  storageFile        StorageFile            @relation(fields: [storageFileId], references: [id], onDelete: Restrict)
  uploadedBy         User                   @relation("PmocEquipmentEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([equipmentExecutionId, storageFileId])
  @@index([organizationId, equipmentExecutionId, createdAt])
  @@map("pmoc_equipment_evidence")
}

// -----------------------------------------------------------------------------
// RVT V2 — TECHNICAL VISIT REPORT
// -----------------------------------------------------------------------------

/// Tipo de manutenção de uma visita técnica.
///
/// ## O que ele substitui
///
/// `RvtConfiguration.visitType` era um literal de **dois** valores — semanal e
/// semestral — e governava a matemática de recorrência (mais 7 dias, ou mais 6
/// meses). Operação real tem mensal, trimestral, anual, e a cada novo ritmo o
/// literal precisava de outra migração e outro `if` no domínio.
///
/// Aqui a cadência é dado: `intervalDays` **ou** `intervalMonths`, um deles.
/// Dias para ritmos curtos, meses para os que seguem o calendário — somar 30
/// dias não é o mesmo que somar um mês, e quem contrata trimestral espera a
/// visita no mesmo dia do terceiro mês.
///
/// ## Cada tipo tem o seu roteiro
///
/// `checklistTemplateId` é o que o técnico preenche em campo, e o que o
/// relatório final descreve. Um tipo sem roteiro é legítimo — nem toda visita
/// tem lista — e aparece como tal na hora de escolher.
model RvtMaintenanceType {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  key                 String    @db.VarChar(60)
  label               String    @db.VarChar(120)
  /// Cadência em dias. Exclusivo com `intervalMonths`.
  intervalDays        Int?      @map("interval_days")
  /// Cadência em meses de calendário. Exclusivo com `intervalDays`.
  intervalMonths      Int?      @map("interval_months")
  checklistTemplateId String?   @map("checklist_template_id") @db.Uuid
  sortOrder           Int       @default(0) @map("sort_order")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  configurations    RvtConfiguration[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive, deletedAt])
  @@map("rvt_maintenance_types")
}

model RvtConfiguration {
  id                                  String    @id @default(uuid(7)) @db.Uuid
  organizationId                      String    @map("organization_id") @db.Uuid
  businessUnitId                      String    @map("business_unit_id") @db.Uuid
  customerId                          String    @map("customer_id") @db.Uuid
  code                                String    @db.VarChar(60)
  name                                String    @db.VarChar(220)
  /// O tipo de manutenção contratado — é dele que sai a cadência.
  maintenanceTypeId                   String?   @map("maintenance_type_id") @db.Uuid
  scheduleMode                        String    @map("schedule_mode") @db.VarChar(20)
  coverageStart                       DateTime  @map("coverage_start") @db.Date
  coverageEnd                         DateTime? @map("coverage_end") @db.Date
  timezone                            String    @db.VarChar(80)
  serviceLocation                     Json      @map("service_location") @db.JsonB
  recurrence                          Json?     @db.JsonB
  procedure                           Json      @default("{}") @db.JsonB
  technicalResponsibleUserId          String?   @map("technical_responsible_user_id") @db.Uuid
  defaultResponsibleFieldTechnicianId String?   @map("default_responsible_field_technician_id") @db.Uuid
  requiresTechnicalResponsible        Boolean   @default(false) @map("requires_technical_responsible")
  status                              String    @default("ACTIVE") @db.VarChar(20)
  metadata                            Json      @default("{}") @db.JsonB
  createdById                         String    @map("created_by_id") @db.Uuid
  createdAt                           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                           DateTime? @map("deleted_at") @db.Timestamptz(3)

  equipment       RvtConfigurationEquipment[]
