/// O contador do número da OS, por organização.
///
/// Mesmo padrão de [PmocCodeSequence], e pela mesma razão: `MAX(numero) + 1`
/// calculado na aplicação faria duas criações simultâneas lerem o mesmo máximo,
/// e uma SEQUENCE por organização seria DDL criado em runtime. Aqui é uma linha
/// por inquilino, incrementada com `ON CONFLICT DO UPDATE` dentro da transação
/// que cria a ordem.
///
/// A autoridade contra duplicidade continua sendo o índice único parcial de
/// `operations`; este contador é quem diz **qual é o próximo**.
model ServiceOrderSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("service_order_sequences")
}

