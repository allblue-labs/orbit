// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique @db.VarChar(320)
  normalizedEmail     String    @unique @map("normalized_email") @db.VarChar(320)
  firstName           String    @map("first_name") @db.VarChar(120)
  lastName            String    @map("last_name") @db.VarChar(120)
  displayName         String    @map("display_name") @db.VarChar(180)
  phone               String?   @db.VarChar(32)
  /// URL pública herdada (provedor externo). Continua publicada porque contas
  /// antigas a possuem; foto enviada pelo produto vive em `avatarFile`.
  avatarUrl           String?   @map("avatar_url") @db.Text
  /// Foto de perfil enviada pelo produto. Referência ao objeto de storage —
  /// nunca o binário, e nunca uma URL permanente.
  avatarStorageFileId String?   @map("avatar_storage_file_id") @db.Uuid
  locale              String    @default("pt-BR") @db.VarChar(16)
  timezone            String    @default("America/Recife") @db.VarChar(64)
  status              String    @default("PENDING_VERIFICATION") @db.VarChar(40)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastAuthenticatedAt DateTime? @map("last_authenticated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  avatarFile                         StorageFile?                   @relation("UserAvatarFile", fields: [avatarStorageFileId], references: [id], onDelete: SetNull)
  credential                         Credential?
  sessions                           Session[]
  ownedOrganizations                 Organization[]                 @relation("OrganizationOwner")
  organizationMemberships            OrganizationMembership[]
  platformRoleAssignments            PlatformRoleAssignment[]
  businessUnitMemberships            BusinessUnitMembership[]
  operationAssignments               OperationUser[]                @relation("OperationAssignedUser")
  assignedOperations                 OperationUser[]                @relation("OperationAssignedBy")
  responsibleFieldOperations         Operation[]                    @relation("OperationResponsibleFieldTechnician")
  startedOperations                  Operation[]                    @relation("OperationStartedBy")
  completedOperations                Operation[]                    @relation("OperationCompletedBy")
  authorizedOperations               Operation[]                    @relation("OperationAuthorizedBy")
  auxiliaryOperationAssignments      OperationAuxiliaryTechnician[] @relation("OperationAuxiliaryUser")
  auxiliaryAssignmentsCreated        OperationAuxiliaryTechnician[] @relation("OperationAuxiliaryAssignedBy")
  auxiliaryAssignmentsRemoved        OperationAuxiliaryTechnician[] @relation("OperationAuxiliaryRemovedBy")
  operationHistory                   OperationHistory[]
  operationAttachments               OperationAttachment[]
  createdReports                     Report[]                       @relation("ReportCreatedBy")
  signatures                         Signature[]                    @relation("SignatureUser")
  notifications                      Notification[]
  checklistExecutions                ChecklistExecution[]           @relation("ChecklistCreatedBy")
  requestedAiExecutions              AiExecution[]                  @relation("AiExecutionUser")
  createdSchedulingEvents            SchedulingEvent[]              @relation("SchedulingEventCreatedBy")
  schedulingAllocations              SchedulingResourceAllocation[]
  schedulingAvailability             SchedulingAvailability[]
  specialties                        MemberSpecialty[]
  certifications                     MemberCertification[]
  teamMemberships                    TeamMembership[]
  ledTeams                           Team[]                         @relation("TeamLeader")
  locations                          MemberLocation[]
  financialEntriesCreated            FinancialEntry[]               @relation("FinancialEntryCreatedBy")
  financialEntriesConfirmed          FinancialEntry[]               @relation("FinancialEntryConfirmedBy")
  financialEntriesCancelled          FinancialEntry[]               @relation("FinancialEntryCancelledBy")
  quotesCreated                      Quote[]                        @relation("QuoteCreatedBy")
  quotesSent                         Quote[]                        @relation("QuoteSentBy")
  quotesDecided                      Quote[]                        @relation("QuoteDecidedBy")
  quotesResponsible                  Quote[]                        @relation("QuoteResponsible")
  inventoryMovements                 InventoryMovement[]            @relation("InventoryMovementActor")
  automationRules                    AutomationRule[]               @relation("AutomationRuleCreatedBy")
  managementReports                  ManagementReport[]             @relation("ManagementReportGeneratedBy")
  pmocPlansCreated                   PmocPlan[]                     @relation("PmocPlanCreatedBy")
  pmocPlansResponsible               PmocPlan[]                     @relation("PmocPlanTechnician")
  pmocPlansTechnicalResponsible      PmocPlan[]                     @relation("PmocPlanTechnicalResponsible")
  pmocExecutionsCompleted            PmocExecution[]                @relation("PmocExecutionCompletedBy")
  pmocEquipmentExecutionsStarted     PmocEquipmentExecution[]       @relation("PmocEquipmentExecutionStartedBy")
  pmocEquipmentExecutionsCompleted   PmocEquipmentExecution[]       @relation("PmocEquipmentExecutionCompletedBy")
  pmocEquipmentExecutionsResponsible PmocEquipmentExecution[]       @relation("PmocEquipmentExecutionResponsible")
  pmocEquipmentEvidenceUploaded      PmocEquipmentEvidence[]        @relation("PmocEquipmentEvidenceUploadedBy")
  schedulingHistory                  SchedulingEventHistory[]
  notificationPreferences            NotificationPreference[]
  notificationDeliveries             NotificationDelivery[]
  pushSubscriptions                  PushSubscription[]
  mobileDeviceInstallations          MobileDeviceInstallation[]
  auditLogs                          AuditLog[]
  invitationsSent                    IdentityInvitation[]           @relation("InvitationInviter")
  passwordResetTokens                PasswordResetToken[]
  mfaFactors                         MfaFactor[]
  createdArtifactTemplates           ArtifactTemplate[]             @relation("ArtifactTemplateCreatedBy")
  createdArtifactVersions            ArtifactTemplateVersion[]      @relation("ArtifactTemplateVersionCreatedBy")
  artifactExecutionsResponsible      ArtifactExecution[]            @relation("ArtifactExecutionResponsible")
  artifactExecutionsCreated          ArtifactExecution[]            @relation("ArtifactExecutionCreatedBy")
  artifactExecutionTeam              ArtifactExecutionTeam[]
  artifactResponses                  ArtifactExecutionResponse[]    @relation("ArtifactResponseAnsweredBy")
  artifactAttachments                ArtifactExecutionAttachment[]  @relation("ArtifactAttachmentUploadedBy")
  artifactSignatures                 ArtifactExecutionSignature[]   @relation("ArtifactSignatureUser")
  storageFilesCreated                StorageFile[]                  @relation("StorageFileCreatedBy")
  artifactManifestsIssued            ArtifactManifest[]             @relation("ArtifactManifestIssuedBy")
  artifactManifestsCreated           ArtifactManifest[]             @relation("ArtifactManifestCreatedBy")
  professionalProfiles               ProfessionalProfile[]
  professionalCredentials            ProfessionalCredential[]
  professionalSignatures             UserSignature[]                @relation("ProfessionalSignatureUser")
  pmocSignatureLinks                 PmocPlanSignatureLink[]        @relation("PmocSignatureLinkCreator")
  fieldEvidenceUploads               FieldEvidenceUpload[]          @relation("FieldEvidenceUploadActor")
  fieldEvidenceCaptured              FieldEvidence[]                @relation("FieldEvidenceCapturedBy")
  customerPortalInvitationsSent      CustomerPortalInvitation[]     @relation("CustomerPortalInvitationInviter")
  assignedCustomerServiceRequests    CustomerServiceRequest[]       @relation("CustomerServiceRequestAssignee")
  customerServiceRequestEvents       CustomerServiceRequestEvent[]  @relation("CustomerServiceRequestInternalActor")
  commissionPolicies                 CommissionPolicy[]             @relation("CommissionPolicyCreatedBy")
  commissionPaymentsReceived         CommissionPayment[]            @relation("CommissionPaymentUser")
  commissionPaymentsCreated          CommissionPayment[]            @relation("CommissionPaymentCreatedBy")
  commissionItems                    CommissionPaymentItem[]        @relation("CommissionPaymentItemUser")
  commissionCancellationsReceived    CommissionCancellation[]       @relation("CommissionCancellationUser")
  commissionCancellationsMade        CommissionCancellation[]       @relation("CommissionCancelledBy")
  commissionCancellationsRevoked     CommissionCancellation[]       @relation("CommissionCancellationRevokedBy")

  @@index([status, deletedAt])
  @@map("users")
  operationCancellationsRequested OperationCancellationRequest[] @relation("OperationCancellationRequestedBy")
  operationCancellationsResolved  OperationCancellationRequest[] @relation("OperationCancellationResolvedBy")
}

model Credential {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model MfaFactor {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @default("TOTP") @db.VarChar(30)
  label         String?   @db.VarChar(100)
  secret        String    @db.Text
  recoveryCodes String[]  @default([]) @map("recovery_codes") @db.VarChar(255)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, deletedAt])
  @@map("mfa_factors")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  businessUnitId  String?   @map("business_unit_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  invitedById     String    @map("invited_by_id") @db.Uuid
  email           String    @db.VarChar(320)
  normalizedEmail String    @map("normalized_email") @db.VarChar(320)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  status          String    @default("PENDING") @db.VarChar(30)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User          @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, normalizedEmail, status])
  @@index([organizationId, expiresAt])
  @@map("identity_invitations")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  businessUnitId   String?   @map("business_unit_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  client           String    @db.VarChar(30)
  deviceId         String?   @map("device_id") @db.VarChar(160)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, businessUnitId])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// SAAS TENANCY / ACCESS / LICENSING
// -----------------------------------------------------------------------------

model Organization {
  id                     String    @id @default(uuid(7)) @db.Uuid
  ownerUserId            String    @map("owner_user_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  slug                   String    @unique @db.VarChar(100)
  displayName            String    @map("display_name") @db.VarChar(180)
  primarySegment         String    @map("primary_segment") @db.VarChar(60)
  status                 String    @default("ONBOARDING") @db.VarChar(40)
  subscriptionStatus     String    @default("TRIALING") @map("subscription_status") @db.VarChar(40)
  subscriptionStartedAt  DateTime? @map("subscription_started_at") @db.Timestamptz(3)
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz(3)
  externalCustomerId     String?   @map("external_customer_id") @db.VarChar(160)
  externalSubscriptionId String?   @map("external_subscription_id") @db.VarChar(160)
  /// A marca da empresa, como data URI. Timbra os documentos de toda unidade
  /// que não tenha logo próprio — e é a única marca que existe para quem opera
  /// com uma unidade só.
  logoUrl                String?   @map("logo_url") @db.Text
  settings               Json?     @db.JsonB
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner                         User                           @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  plan                          Plan                           @relation(fields: [planId], references: [id], onDelete: Restrict)
  businessUnits                 BusinessUnit[]
  memberships                   OrganizationMembership[]
  roles                         Role[]
  usages                        PlanUsage[]
  usageEvents                   PlanUsageEvent[]
  subscriptions                 OrganizationSubscription[]
  trialGrants                   SubscriptionTrialGrant[]
  billingCustomers              BillingCustomer[]
  billingCheckoutAttempts       BillingCheckoutAttempt[]
  billingInvoices               BillingInvoice[]
  billingInvoiceTransitions     BillingInvoiceTransition[]
  billingFinancialAdjustments   BillingFinancialAdjustment[]
  integrations                  Integration[]
  sessions                      Session[]
  customers                     Customer[]
  customerAddresses             CustomerAddress[]
  categories                    ProductCategory[]
  products                      Product[]
  assets                        Asset[]
  equipmentQrIdentities         EquipmentQrIdentity[]
  operations                    Operation[]
  operationAuxiliaryTechnicians OperationAuxiliaryTechnician[]
  pmocEquipmentExecutions       PmocEquipmentExecution[]
  pmocEquipmentEvidence         PmocEquipmentEvidence[]
  reportTemplates               ReportTemplate[]
  artifactTemplates             ArtifactTemplate[]
  artifactTemplateVersions      ArtifactTemplateVersion[]
  artifactSnapshots             ArtifactSnapshot[]
  artifactExecutions            ArtifactExecution[]
  artifactResponses             ArtifactExecutionResponse[]
  artifactAttachments           ArtifactExecutionAttachment[]
  artifactSignatures            ArtifactExecutionSignature[]
  artifactInsights              ArtifactExecutionInsight[]
  storageFiles                  StorageFile[]
  artifactManifests             ArtifactManifest[]
  backgroundJobs                BackgroundJob[]
  reports                       Report[]
  checklistTemplates            ChecklistTemplate[]
  checklistExecutions           ChecklistExecution[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  pushSubscriptions             PushSubscription[]
  mobileDeviceInstallations     MobileDeviceInstallation[]
  mobilePushDeliveries          MobilePushDelivery[]
  aiAgents                      AiAgent[]
  aiExecutions                  AiExecution[]
  auditLogs                     AuditLog[]
  calendars                     SchedulingCalendar[]
  schedulingEvents              SchedulingEvent[]
  schedulingAvailability        SchedulingAvailability[]
  invitations                   IdentityInvitation[]
  businessUnitMemberships       BusinessUnitMembership[]
  specialties                   Specialty[]
  memberSpecialties             MemberSpecialty[]
  memberCertifications          MemberCertification[]
  teams                         Team[]
  teamMemberships               TeamMembership[]
  memberLocations               MemberLocation[]
  financialCategories           FinancialCategory[]
  financialEntries              FinancialEntry[]
  financialSettings             FinancialSettings?
  quotes                        Quote[]
  quoteItems                    QuoteItem[]
  inventoryMovements            InventoryMovement[]
  inventoryBalances             InventoryBalance[]
  domainEvents                  DomainEvent[]
  automationRules               AutomationRule[]
  automationExecutions          AutomationExecution[]
  managementReports             ManagementReport[]
  pmocPlans                     PmocPlan[]
  pmocSignatureLinks            PmocPlanSignatureLink[]
  pmocCoverages                 PmocEquipmentCoverage[]
  pmocExecutions                PmocExecution[]
  professionalProfiles          ProfessionalProfile[]
  professionalCredentials       ProfessionalCredential[]
  professionalSignatures        UserSignature[]
  fieldEvidenceUploads          FieldEvidenceUpload[]
  fieldEvidence                 FieldEvidence[]
  customerPortalIdentities      CustomerPortalIdentity[]
  customerPortalSessions        CustomerPortalSession[]
  customerPortalInvitations     CustomerPortalInvitation[]
  customerPortalPasswordResets  CustomerPortalPasswordReset[]
  customerServiceRequests       CustomerServiceRequest[]
  customerServiceRequestEvents  CustomerServiceRequestEvent[]

  pmocCodeSequences       PmocCodeSequence[]
  serviceOrderSequence    ServiceOrderSequence?
  productSkuSequences     ProductSkuSequence[]
  assetInternalCodes      AssetInternalCodeSequence?
  receiptSequence         ReceiptSequence?
  pmocUnits               PmocUnit[]
  rvtMaintenanceTypes     RvtMaintenanceType[]
  commissionPolicy        CommissionPolicy?
  commissionPayments      CommissionPayment[]
  commissionPaymentItems  CommissionPaymentItem[]
  commissionCancellations CommissionCancellation[]

  @@index([ownerUserId, status])
  @@index([planId, subscriptionStatus])
  @@map("organizations")
  operationCancellationRequests OperationCancellationRequest[]
}

model BusinessUnit {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  parentId              String?   @map("parent_id") @db.Uuid
  slug                  String    @db.VarChar(100)
  code                  String?   @db.VarChar(60)
  type                  String    @default("BRANCH") @db.VarChar(40)
  isPrimary             Boolean   @default(false) @map("is_primary")
  legalName             String    @map("legal_name") @db.VarChar(255)
  tradeName             String?   @map("trade_name") @db.VarChar(255)
  documentType          String    @map("document_type") @db.VarChar(20)
  documentNumber        String    @map("document_number") @db.VarChar(32)
  stateRegistration     String?   @map("state_registration") @db.VarChar(40)
  municipalRegistration String?   @map("municipal_registration") @db.VarChar(40)
  taxRegime             String?   @map("tax_regime") @db.VarChar(50)
  email                 String?   @db.VarChar(320)
  phone                 String?   @db.VarChar(32)
  website               String?   @db.VarChar(255)
  logoUrl               String?   @map("logo_url") @db.Text
  countryCode           String    @default("BR") @map("country_code") @db.Char(2)
  postalCode            String?   @map("postal_code") @db.VarChar(16)
  state                 String?   @db.VarChar(120)
  stateCode             String?   @map("state_code") @db.VarChar(10)
  city                  String    @db.VarChar(160)
  district              String?   @db.VarChar(160)
  street                String    @db.VarChar(255)
  number                String?   @db.VarChar(30)
  complement            String?   @db.VarChar(160)
  timezone              String    @default("America/Recife") @db.VarChar(64)
  locale                String    @default("pt-BR") @db.VarChar(16)
  currency              String    @default("BRL") @db.Char(3)
  status                String    @default("ACTIVE") @db.VarChar(40)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                  BusinessUnit?            @relation("BusinessUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                BusinessUnit[]           @relation("BusinessUnitHierarchy")
  memberships             BusinessUnitMembership[]
  sessions                Session[]
  contacts                Contact[]
  equipmentQrIdentities   EquipmentQrIdentity[]
  assets                  Asset[]
  products                Product[]
  operations              Operation[]
  reports                 Report[]
  notifications           Notification[]
  checklistExecutions     ChecklistExecution[]
  auditLogs               AuditLog[]
  calendars               SchedulingCalendar[]
  schedulingEvents        SchedulingEvent[]
  schedulingAvailability  SchedulingAvailability[]
  invitations             IdentityInvitation[]
  artifactExecutions      ArtifactExecution[]
  storageFiles            StorageFile[]
  artifactManifests       ArtifactManifest[]
  backgroundJobs          BackgroundJob[]
  pmocEquipmentExecutions PmocEquipmentExecution[]

  teams Team[]

  financialEntries FinancialEntry[]

  quotes Quote[]

  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]

  automationRules AutomationRule[]

  managementReports       ManagementReport[]
  pmocPlans               PmocPlan[]
  fieldEvidenceUploads    FieldEvidenceUpload[]
  fieldEvidence           FieldEvidence[]
  customerServiceRequests CustomerServiceRequest[]
  commissionPayments      CommissionPayment[]

  @@unique([organizationId, slug])
  @@unique([organizationId, documentType, documentNumber])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, isPrimary])
  @@map("business_units")
  operationCancellationRequests OperationCancellationRequest[]
}

model OrganizationMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  status         String    @default("ACTIVE") @db.VarChar(40)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// Optional access override for one member. BusinessUnitMembership remains
  /// scope-only; it never grants permissions or surfaces.
  usesCustomAccess      Boolean  @default(false) @map("uses_custom_access")
  customPermissions     String[] @default([]) @map("custom_permissions") @db.VarChar(160)
  customAllowedSurfaces String[] @default([]) @map("custom_allowed_surfaces") @db.VarChar(10)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model BusinessUnitMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  status         String    @default("ACTIVE") @db.VarChar(40)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, userId])
  @@index([organizationId, userId, status])
  @@map("business_unit_memberships")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  permissions    String[] @default([]) @db.VarChar(160)

  /// Onde este papel pode entrar: `WEB`, `MOBILE`, `API`.
  ///
  /// O técnico operacional e o auxiliar existem para o aplicativo de campo —
  /// o painel web é da administração da operação. Antes disso não havia nada
  /// separando as duas superfícies: quem recebia uma senha temporária para o
  /// celular entrava no painel e enxergava a organização inteira.
  ///
  /// É coluna do papel, e não uma lista de chaves no código, porque o dono
  /// cria papéis próprios: uma constante com `FIELD_TECHNICIAN` dentro deixaria
  /// passar o "Ajudante" que ele cadastrar amanhã.
  allowedSurfaces String[] @default(["WEB", "MOBILE"]) @map("allowed_surfaces") @db.VarChar(10)

  isSystem  Boolean   @default(false) @map("is_system")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationMemberships OrganizationMembership[]
  businessUnitMemberships BusinessUnitMembership[]
  invitations             IdentityInvitation[]
  platformAssignments     PlatformRoleAssignment[]

  @@unique([organizationId, key])
  @@index([organizationId, isSystem, deletedAt])
  @@map("roles")
}

/// Global roles are assigned independently from tenant memberships. A
/// PLATFORM_ADMIN can therefore authenticate without belonging to a customer
/// organization and receives RLS bypass only through its signed identity.
model PlatformRoleAssignment {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("platform_role_assignments")
}

model Module {
  id           String   @id @default(uuid(7)) @db.Uuid
  tag          String   @unique @default(uuid(7)) @db.Uuid
  key          String   @unique @db.VarChar(100)
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  route        String?  @db.VarChar(180)
  icon         String?  @db.VarChar(80)
  capabilities String[] @default([]) @db.VarChar(160)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("modules")
}

model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  key          String   @unique @db.VarChar(40)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  monthlyPrice Decimal? @map("monthly_price") @db.Decimal(12, 2)
  annualPrice  Decimal? @map("annual_price") @db.Decimal(12, 2)
  currency     String   @default("BRL") @db.Char(3)
  moduleTags   String[] @default([]) @map("module_tags") @db.Uuid
  capabilities String[] @default([]) @db.VarChar(160)
  limits       Json     @default("{}") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]

  @@index([isActive])
  @@map("plans")
}

model PlanUsage {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  resource       String   @db.VarChar(100)
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  used           Decimal  @default(0) @db.Decimal(20, 4)
  reserved       Decimal  @default(0) @db.Decimal(20, 4)
  metadata       Json?    @db.JsonB
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resource, periodStart, periodEnd])
  @@index([organizationId, periodEnd])
  @@map("plan_usage")
}

/// Cada consumo de cota, uma linha — o razão de uso.
///
/// O agregado `plan_usage` responde "quanto já se usou" em O(1); este razão
/// responde "por causa de quê", e é ele que torna a contagem idempotente: o
/// índice único por origem faz a segunda tentativa do mesmo evento de negócio
/// falhar em vez de somar de novo. É o que separa um retry técnico de uma nova
/// emissão — renderizar três vezes o mesmo documento consome uma unidade.
model PlanUsageEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  resource       String   @db.VarChar(100)
  /// A janela é sempre mensal, e vem de fora: a PR-PL-02 dará a âncora da
  /// assinatura. Nada aqui deriva do mês do calendário.
  windowStart    DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd      DateTime @map("window_end") @db.Timestamptz(3)
  quantity       Decimal  @default(1) @db.Decimal(20, 4)
  /// A identidade do evento de negócio que consumiu a cota.
  sourceType     String   @map("source_type") @db.VarChar(60)
  sourceId       String   @map("source_id") @db.VarChar(120)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resource, sourceType, sourceId], map: "plan_usage_events_source_unique")
  @@index([organizationId, resource, windowStart, windowEnd])
  @@map("plan_usage_events")
}

/// A autoridade comercial da organização.
///
/// O que a empresa contratou, por quanto tempo e com que direitos — e é ela,
/// não `organizations.plan_id`, que responde a partir da PR-PL-02. A coluna
/// antiga continua existindo por compatibilidade e vira eco, não fonte.
///
/// ## O retrato vale mais que o catálogo
///
/// `entitlementsSnapshot` guarda os direitos **no momento da contratação**.
/// Se amanhã o Essencial passar de 5 para 8 usuários, quem assinou ontem
/// continua com 5 até renovar ou trocar de plano — um contrato histórico não
/// muda porque alguém editou uma tabela.
///
/// ## Cobrança e uso são períodos diferentes
///
/// `currentPeriodStart/End` é o **acesso comprado**: 1, 6 ou 12 meses. A
/// janela de uso é sempre de um mês e sai da mesma âncora. Assinar por ano não
/// adianta doze meses de cota.
model OrganizationSubscription {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Código do catálogo contratado. Estável; o rótulo comercial pode mudar.
  planCode             String @map("plan_code") @db.VarChar(60)
  /// Versão do catálogo vigente quando o retrato foi tirado.
  catalogVersion       Int    @map("catalog_version")
  /// `{ capabilities, allocation, usage }` — o mesmo formato que o resolvedor
  /// de direitos já valida, para não existirem dois caminhos de leitura.
  entitlementsSnapshot Json   @map("entitlements_snapshot") @db.JsonB

  /// `MONTHLY` · `SEMIANNUAL` · `ANNUAL`. Muda preço e duração, nunca direito.
  billingInterval String @map("billing_interval") @db.VarChar(20)
  /// `PENDING_PAYMENT` · `TRIALING` · `ACTIVE` · `PAST_DUE` ·
  /// `GRACE_PERIOD` · `SUSPENDED` · `CANCELED` · `EXPIRED`.
  status          String @db.VarChar(20)

  /// O aniversário. Cobrança e uso saem daqui, e não do mês do calendário.
  billingAnchorAt    DateTime @map("billing_anchor_at") @db.Timestamptz(3)
  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)

  trialStartsAt DateTime? @map("trial_starts_at") @db.Timestamptz(3)
  trialEndsAt   DateTime? @map("trial_ends_at") @db.Timestamptz(3)

  /// Cancelamento é sempre no fim do período já pago. Não há devolução aqui.
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt        DateTime? @map("canceled_at") @db.Timestamptz(3)

  graceStartsAt DateTime? @map("grace_starts_at") @db.Timestamptz(3)
  graceEndsAt   DateTime? @map("grace_ends_at") @db.Timestamptz(3)

  /// Mudança programada. Rebaixar vale no próximo período; subir vale agora e
  /// não passa por aqui.
  pendingPlanCode             String?   @map("pending_plan_code") @db.VarChar(60)
  pendingBillingInterval      String?   @map("pending_billing_interval") @db.VarChar(20)
  pendingCatalogVersion       Int?      @map("pending_catalog_version")
  pendingEntitlementsSnapshot Json?     @map("pending_entitlements_snapshot") @db.JsonB
  pendingEffectiveAt          DateTime? @map("pending_effective_at") @db.Timestamptz(3)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Preenchido quando a assinatura deixa de ser a corrente. Histórico fica.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  /// O vínculo com o provedor de pagamento.
  ///
  /// Colunas opcionais de propósito: uma assinatura existe e vale sem provedor
  /// nenhum — é assim que a avaliação gratuita e os inquilinos anteriores à
  /// integração continuam funcionando. `providerStatus` é diagnóstico; quem
  /// decide acesso é `status`.
  provider               String?   @db.VarChar(20)
  providerSubscriptionId String?   @unique @map("provider_subscription_id") @db.VarChar(255)
  providerCustomerId     String?   @map("provider_customer_id") @db.VarChar(255)
  providerPriceId        String?   @map("provider_price_id") @db.VarChar(255)
  providerStatus         String?   @map("provider_status") @db.VarChar(40)
  /// O último evento do provedor já aplicado a esta linha.
  providerLastEventId    String?   @map("provider_last_event_id") @db.VarChar(255)
  providerUpdatedAt      DateTime? @map("provider_updated_at") @db.Timestamptz(3)

  /// Controle otimista: dois comandos concorrentes não produzem estado torto.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trialGrants      SubscriptionTrialGrant[]
  checkoutAttempts BillingCheckoutAttempt[]
  billingInvoices  BillingInvoice[]

  @@unique([id, organizationId], map: "organization_subscriptions_tenant_identity")
  @@index([organizationId, endedAt])
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([status, graceEndsAt])
  @@index([pendingEffectiveAt])
  @@index([provider, providerCustomerId])
  @@map("organization_subscriptions")
}

/// A concessão de avaliação gratuita — e a memória de que ela aconteceu.
///
/// O índice único é **global**, e é ele o antifraude: a mesma entidade
/// jurídica não recebe um segundo período de teste, nem criando outra conta,
/// nem outra organização, nem mudando de endereço. Não é uma consulta que
/// alguém pode esquecer de fazer; é o banco recusando a segunda linha.
///
/// O documento cru não mora aqui. O que mora é o HMAC dele, com segredo do
/// servidor: CPF e CNPJ são enumeráveis, e um SHA simples desta coluna seria
/// um dicionário reversível de quem já testou o Orbit.
model SubscriptionTrialGrant {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  planCode       String @map("plan_code") @db.VarChar(60)

  /// HMAC-SHA256 do documento normalizado. Único no sistema inteiro.
  legalDocumentFingerprint String @unique(map: "subscription_trial_grants_fingerprint_unique") @map("legal_document_fingerprint") @db.Char(64)

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)

  /// `GRANTED` · `CONVERTED` · `EXPIRED`.
  status String @db.VarChar(20)

  /// `ALLOW` · `REVIEW_REQUIRED` · `DENY`. Hoje só o documento decide negar;
  /// os demais sinais são registrados, e não bloqueiam sozinhos.
  riskDecision String @map("risk_decision") @db.VarChar(20)
  riskSignals  Json?  @map("risk_signals") @db.JsonB

  convertedSubscriptionId String? @map("converted_subscription_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription? @relation(fields: [convertedSubscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status, endsAt])
  @@map("subscription_trial_grants")
}

/// A identidade da organização no provedor de pagamento.
///
/// Uma por organização, por provedor e por modo — misturar identificador de
/// teste com chave de produção é o acidente mais comum desta integração, e o
/// índice único torna isso impossível de acontecer por descuido.
///
/// O e-mail **não** é chave. E-mail muda, repete entre empresas do mesmo grupo
/// e não pertence a ninguém; o identificador do provedor é persistido porque é
/// ele que a reconciliação usa.
model BillingCustomer {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// `STRIPE`. Um só, por enquanto — enum ornamental não ajuda ninguém.
  provider           String @db.VarChar(20)
  /// `TEST` ou `LIVE`.
  mode               String @db.VarChar(10)
  providerCustomerId String @map("provider_customer_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkoutAttempts BillingCheckoutAttempt[]

  @@unique([id, organizationId], map: "billing_customers_tenant_identity")
  @@unique([provider, providerCustomerId], map: "billing_customers_provider_customer_unique")
  @@unique([organizationId, provider, mode], map: "billing_customers_organization_unique")
  @@index([organizationId])
  @@map("billing_customers")
}

/// Uma intenção de primeira contratação criada pelo Orbit.
///
/// Ela existe antes da chamada de rede. Assim, retry, concorrência e webhook
/// possuem a mesma identidade server-owned; o redirect do navegador nunca é a
/// autoridade que concede acesso.
model BillingCheckoutAttempt {
  id                String @id @default(uuid(7)) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  subscriptionId    String @map("subscription_id") @db.Uuid
  billingCustomerId String @map("billing_customer_id") @db.Uuid

  provider String @db.VarChar(20)
  mode     String @db.VarChar(10)

  planCode        String @map("plan_code") @db.VarChar(60)
  billingInterval String @map("billing_interval") @db.VarChar(20)

  /// `CREATING` · `OPEN` · `COMPLETED` · `EXPIRED` · `FAILED`.
  status String @default("CREATING") @db.VarChar(20)

  idempotencyKey         String  @map("idempotency_key") @db.VarChar(64)
  providerSessionId      String? @map("provider_session_id") @db.VarChar(255)
  providerSubscriptionId String? @map("provider_subscription_id") @db.VarChar(255)

  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  failureCode String?   @map("failure_code") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    OrganizationSubscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  billingCustomer BillingCustomer          @relation(fields: [billingCustomerId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([provider, idempotencyKey], map: "billing_checkout_attempts_idempotency_unique")
  @@unique([provider, providerSessionId], map: "billing_checkout_attempts_provider_session_unique")
  @@index([organizationId, status, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("billing_checkout_attempts")
}

/// Projeção financeira canônica de uma fatura do provedor.
///
/// Não guarda cartão, endereço, documento fiscal nem client secret. Valores
/// são inteiros na menor unidade monetária e URLs são as superfícies hospedadas
/// pelo próprio provedor, já validadas pelo adaptador.
model BillingInvoice {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  provider          String  @db.VarChar(20)
  mode              String  @db.VarChar(10)
  providerInvoiceId String  @map("provider_invoice_id") @db.VarChar(255)
  invoiceNumber     String? @map("invoice_number") @db.VarChar(120)

  status               String @db.VarChar(30)
  currency             String @db.Char(3)
  subtotalMinor        Int    @map("subtotal_minor")
  discountMinor        Int    @map("discount_minor")
  taxMinor             Int    @map("tax_minor")
  totalMinor           Int    @map("total_minor")
  amountDueMinor       Int    @map("amount_due_minor")
  amountPaidMinor      Int    @map("amount_paid_minor")
  amountRemainingMinor Int    @map("amount_remaining_minor")
  creditNotesMinor     Int    @map("credit_notes_minor")

  attempted        Boolean
  attemptCount     Int     @map("attempt_count")
  billingReason    String? @map("billing_reason") @db.VarChar(60)
  collectionMethod String  @map("collection_method") @db.VarChar(40)

  hostedInvoiceUrl String? @map("hosted_invoice_url") @db.VarChar(2048)
  invoicePdfUrl    String? @map("invoice_pdf_url") @db.VarChar(2048)

  periodStart           DateTime  @map("period_start") @db.Timestamptz(3)
  periodEnd             DateTime  @map("period_end") @db.Timestamptz(3)
  dueAt                 DateTime? @map("due_at") @db.Timestamptz(3)
  nextPaymentAttemptAt  DateTime? @map("next_payment_attempt_at") @db.Timestamptz(3)
  finalizedAt           DateTime? @map("finalized_at") @db.Timestamptz(3)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  voidedAt              DateTime? @map("voided_at") @db.Timestamptz(3)
  markedUncollectibleAt DateTime? @map("marked_uncollectible_at") @db.Timestamptz(3)
  providerCreatedAt     DateTime  @map("provider_created_at") @db.Timestamptz(3)
  providerObservedAt    DateTime  @map("provider_observed_at") @db.Timestamptz(3)
  lastProviderEventId   String?   @map("last_provider_event_id") @db.VarChar(255)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription     @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transitions  BillingInvoiceTransition[]
  adjustments  BillingFinancialAdjustment[]

  @@unique([id, organizationId], map: "billing_invoices_tenant_identity")
  @@unique([provider, providerInvoiceId], map: "billing_invoices_provider_invoice_unique")
  @@index([organizationId, providerCreatedAt(sort: Desc)])
  @@index([subscriptionId, providerCreatedAt(sort: Desc)])
  @@map("billing_invoices")
}

/// Razão append-only das observações que formaram a projeção da fatura.
model BillingInvoiceTransition {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  billingInvoiceId     String   @map("billing_invoice_id") @db.Uuid
  provider             String   @db.VarChar(20)
  providerEventId      String   @map("provider_event_id") @db.VarChar(255)
  status               String   @db.VarChar(30)
  totalMinor           Int      @map("total_minor")
  amountPaidMinor      Int      @map("amount_paid_minor")
  amountRemainingMinor Int      @map("amount_remaining_minor")
  attemptCount         Int      @map("attempt_count")
  observedAt           DateTime @map("observed_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice @relation(fields: [billingInvoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([provider, providerEventId], map: "billing_invoice_transitions_provider_event_unique")
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([billingInvoiceId, createdAt])
  @@map("billing_invoice_transitions")
}

/// Reembolso ou disputa correlacionado a uma fatura da organização.
model BillingFinancialAdjustment {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  billingInvoiceId    String   @map("billing_invoice_id") @db.Uuid
  provider            String   @db.VarChar(20)
  type                String   @db.VarChar(20)
  providerObjectId    String   @map("provider_object_id") @db.VarChar(255)
  status              String   @db.VarChar(40)
  amountMinor         Int      @map("amount_minor")
  currency            String   @db.Char(3)
  reason              String?  @db.VarChar(80)
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(3)
  providerObservedAt  DateTime @map("provider_observed_at") @db.Timestamptz(3)
  lastProviderEventId String   @map("last_provider_event_id") @db.VarChar(255)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice @relation(fields: [billingInvoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([provider, type, providerObjectId], map: "billing_financial_adjustments_provider_object_unique")
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([billingInvoiceId, occurredAt])
  @@map("billing_financial_adjustments")
}

/// A caixa de entrada dos eventos do provedor.
///
/// ## Por que existe
///
/// O webhook precisa responder rápido e não pode perder evento. Guardar
/// primeiro e processar depois separa as duas coisas: a resposta ao provedor
/// depende só de verificar a assinatura e gravar uma linha; o trabalho pesado
/// acontece fora do ciclo da requisição.
///
/// ## Por que o índice único é o antifraude da duplicidade
///
/// Provedores reentregam. O mesmo evento pode chegar dez vezes, e nenhuma
/// delas pode virar um segundo efeito. O único por `(provider, event)` decide
/// isso no banco — não numa consulta anterior, que teria janela entre ler e
/// escrever.
///
/// ## Por que não guarda o corpo inteiro
///
/// O que o processamento precisa é do objeto **canônico** do provedor, buscado
/// na hora de reconciliar — um corpo antigo guardado seria justamente a versão
/// desatualizada que causa regressão de estado. E o corpo carrega dados que
/// não temos motivo para reter.
model BillingWebhookEvent {
  id String @id @default(uuid(7)) @db.Uuid

  provider               String  @db.VarChar(20)
  providerEventId        String  @map("provider_event_id") @db.VarChar(255)
  eventType              String  @map("event_type") @db.VarChar(120)
  /// O objeto tocado, e a assinatura envolvida quando o evento a revela.
  providerObjectId       String? @map("provider_object_id") @db.VarChar(255)
  providerSubscriptionId String? @map("provider_subscription_id") @db.VarChar(255)
  apiVersion             String? @map("api_version") @db.VarChar(40)

  providerCreatedAt   DateTime  @map("provider_created_at") @db.Timestamptz(3)
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  /// `PENDING` · `PROCESSING` · `PROCESSED` · `IGNORED` · `DEAD_LETTER`.
  processingStatus    String    @default("PENDING") @map("processing_status") @db.VarChar(20)
  attempts            Int       @default(0)
  nextAttemptAt       DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  processingToken     String?   @map("processing_token") @db.Uuid
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(3)
  deadLetteredAt      DateTime? @map("dead_lettered_at") @db.Timestamptz(3)
  /// Código curto da falha. Nunca a mensagem crua do provedor.
  lastErrorCode       String?   @map("last_error_code") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId], map: "billing_webhook_events_provider_event_unique")
  @@index([processingStatus, receivedAt])
  @@index([processingStatus, nextAttemptAt, leaseExpiresAt], map: "billing_webhook_events_claim_idx")
  @@index([providerSubscriptionId])
  @@map("billing_webhook_events")
}

model Integration {
