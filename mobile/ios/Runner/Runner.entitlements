<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug usa development; Release usa production, com override local
         para instalação de desenvolvimento. O perfil Apple precisa corresponder.
         O Firebase SDK associa o token APNs ao token FCM do mesmo aparelho. -->
	<key>aps-environment</key>
	<string>$(ORBIT_APNS_ENVIRONMENT)</string>
</dict>
</plist>
