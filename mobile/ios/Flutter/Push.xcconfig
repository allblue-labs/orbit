// Release mode also supports direct installation with an Apple Personal Team.
// APNs requires an explicit opt-in and a provisioning profile that supports it.
// APNs credentials belong to the configured server push gateway, never the app.
ORBIT_PUSH_ENTITLEMENTS =

// Copy Push.local.xcconfig.example to Push.local.xcconfig on machines/CI builds
// signed with a compatible Apple Developer Program team.
#include? "Push.local.xcconfig"
