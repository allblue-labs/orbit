// Debug builds default to no APNs entitlement so Personal Teams can run locally.
// Release.xcconfig enables Runner/Runner.entitlements for distribution builds.
// For push on a debug device, use an Apple team/provisioning profile with Push
// Notifications enabled and override ORBIT_PUSH_ENTITLEMENTS with that same path.
// APNs credentials belong to the configured server push gateway, never the app.
ORBIT_PUSH_ENTITLEMENTS =
